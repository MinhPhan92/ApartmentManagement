@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 text-center bg-gradient" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <div class="mb-2">
                        <span class="fs-1">🏢</span>
                    </div>
                    <h3 class="fw-bold mb-1">Apartment Hub</h3>
                    <p class="mb-0 text-white-50 small">Hệ Thống Quản Lý Chung Cư Thông Minh</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <h4 class="text-dark fw-bold text-center mb-4">Đăng Nhập</h4>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.UserNameOrEmail" class="form-label fw-semibold text-secondary small">Tài khoản hoặc Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i>👤</span>
                                <input asp-for="Input.UserNameOrEmail" id="inputUsername" class="form-control border-start-0 ps-0" autocomplete="username" aria-required="true" placeholder="Nhập tên đăng nhập hoặc email" />
                            </div>
                            <span asp-validation-for="Input.UserNameOrEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <label asp-for="Input.Password" class="form-label fw-semibold text-secondary small">Mật khẩu</label>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-muted">Quên mật khẩu?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i>🔑</span>
                                <input asp-for="Input.Password" id="inputPassword" class="form-control border-start-0 ps-0" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                            <label class="form-check-label text-secondary small" for="rememberMeCheck">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border: none;">
                            Đăng Nhập
                        </button>
                    </form>

                    <!-- Quick Demo Logins -->
                    <div class="mt-4 pt-3 border-top">
                        <p class="text-center text-muted small fw-semibold mb-2">Tài khoản Demo thử nghiệm nhanh</p>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin', 'Admin@123')">
                                <span>🛡️ <strong>System Admin</strong> (admin)</span>
                                <span class="badge bg-primary text-white">Điền</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('manager', 'Manager@123')">
                                <span>🏢 <strong>Quản Lý Tòa Nhà</strong> (manager)</span>
                                <span class="badge bg-success text-white">Điền</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('resident', 'Resident@123')">
                                <span>🏠 <strong>Cư Dân Căn Hộ</strong> (resident)</span>
                                <span class="badge bg-info text-dark">Điền</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light text-center py-3 border-0 small text-muted">
                    Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Đăng ký mới</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(username, password) {
            const userInput = document.getElementById('inputUsername');
            const passInput = document.getElementById('inputPassword');
            if (userInput && passInput) {
                userInput.value = username;
                passInput.value = password;
                userInput.focus();
            }
        }
    </script>
}
