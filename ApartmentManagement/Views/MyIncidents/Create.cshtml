@model IncidentTicketCreateViewModel
@{
    ViewData["Title"] = "Gửi phiếu sự cố";
}
<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 760px">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-2">Gửi phiếu sự cố</h1>
            <p class="text-muted">Chỉ có thể chọn căn hộ đang cư trú của bạn.</p>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="ApartmentId" class="form-label">Căn hộ</label>
                    <select asp-for="ApartmentId" asp-items="Model.Apartments" class="form-select">
                        <option value="">-- Chọn căn hộ --</option>
                    </select>
                    <span asp-validation-for="ApartmentId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Loại sự cố</label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<IncidentCategory>()" class="form-select">
                        <option value="">-- Chọn loại sự cố --</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" maxlength="120" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="5" maxlength="4000"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Gửi phiếu</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
