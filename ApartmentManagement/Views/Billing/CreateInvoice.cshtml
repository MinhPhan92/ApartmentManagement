@model GenerateInvoiceViewModel
@{
    ViewData["Title"] = "Lập hóa đơn nháp";
}
<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 700px">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold">Lập hóa đơn nháp</h1>
            <p class="text-muted">Hóa đơn nháp chưa hiển thị cho cư dân. Kiểm tra chi tiết rồi phát hành.</p>
            <form asp-action="CreateInvoice" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="ApartmentId" class="form-label">Căn hộ</label><select asp-for="ApartmentId" asp-items="Model.ApartmentOptions" class="form-select"><option value="">-- Chọn căn hộ --</option></select><span asp-validation-for="ApartmentId" class="text-danger"></span></div>
                <div class="row">
                    <div class="col-md-4 mb-3"><label asp-for="BillingMonth" class="form-label">Tháng</label><input asp-for="BillingMonth" class="form-control" /></div>
                    <div class="col-md-4 mb-3"><label asp-for="BillingYear" class="form-label">Năm</label><input asp-for="BillingYear" class="form-control" /></div>
                    <div class="col-md-4 mb-3"><label asp-for="DueDate" class="form-label">Hạn thanh toán</label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span></div>
                </div>
                <button type="submit" class="btn btn-primary">Tính và tạo bản nháp</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
