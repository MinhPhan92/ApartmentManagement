@using ApartmentManagement.Services
@model BatchIssueInvoicesViewModel
@{
    ViewData["Title"] = "Phát hành hóa đơn tòa nhà";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-action="Index">Phí & Hóa đơn</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phát hành hóa đơn tòa nhà</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1">Phát hành hóa đơn nháp theo tòa nhà</h1>
                <p class="text-muted mb-0">Xem và phát hành hàng loạt hóa đơn trạng thái Nháp (Draft) sang Đã phát hành (Issued) cho cư dân.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="BatchCreateInvoices" asp-route-buildingId="@Model.BuildingId" asp-route-year="@Model.BillingYear" asp-route-month="@Model.BillingMonth" class="btn btn-outline-secondary">
                    <i class="bi bi-collection"></i> Lập hóa đơn nháp
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="status">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" asp-action="BatchIssueInvoices" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="BuildingId" class="form-label fw-semibold">Tòa nhà <span class="text-danger">*</span></label>
                    <select asp-for="BuildingId" asp-items="Model.BuildingOptions" class="form-select form-select-lg">
                        <option value="">-- Chọn tòa nhà --</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="BillingMonth" class="form-label fw-semibold">Tháng tính phí <span class="text-danger">*</span></label>
                    <input asp-for="BillingMonth" class="form-control form-control-lg" type="number" min="1" max="12" />
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="BillingYear" class="form-label fw-semibold">Năm tính phí <span class="text-danger">*</span></label>
                    <input asp-for="BillingYear" class="form-control form-control-lg" type="number" min="2000" max="2200" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 d-inline-flex justify-content-center align-items-center gap-2">
                        <i class="bi bi-search"></i> Tải danh sách
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Processing Results (if posted) -->
    @if (Model.Result != null)
    {
        var r = Model.Result;
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-check text-success"></i> Kết quả phát hành hàng loạt
                </h2>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="text-muted small">Đã chọn</div>
                            <div class="fs-4 fw-bold text-dark">@r.TotalSelected</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 text-center">
                            <div class="text-success small fw-semibold">Phát hành thành công</div>
                            <div class="fs-4 fw-bold text-success">@r.IssuedCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-info bg-opacity-10 rounded-3 text-center">
                            <div class="text-info small fw-semibold">Đã phát hành trước</div>
                            <div class="fs-4 fw-bold text-info">@r.AlreadyIssuedCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-center">
                            <div class="text-danger small fw-semibold">Lỗi phát hành</div>
                            <div class="fs-4 fw-bold text-danger">@r.FailedCount</div>
                        </div>
                    </div>
                </div>

                @if (r.Items.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 140px;">Căn hộ</th>
                                    <th style="width: 200px;">Mã hóa đơn</th>
                                    <th style="width: 150px;">Trạng thái</th>
                                    <th style="width: 140px;" class="text-end">Tổng tiền</th>
                                    <th>Thông báo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in r.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ApartmentCode</td>
                                        <td class="font-monospace small">@item.InvoiceCode</td>
                                        <td>
                                            @switch (item.Status)
                                            {
                                                case BatchIssueItemStatus.Issued:
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check2"></i> Đã phát hành
                                                    </span>
                                                    break;
                                                case BatchIssueItemStatus.AlreadyIssued:
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        <i class="bi bi-info-circle"></i> Đã có sẵn
                                                    </span>
                                                    break;
                                                case BatchIssueItemStatus.ConcurrencyConflict:
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="bi bi-exclamation-triangle"></i> Xung đột dữ liệu
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="bi bi-x-circle"></i> Thất bại
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end font-monospace">@item.TotalAmount.ToString("N0") ₫</td>
                                        <td class="small text-muted">@item.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Invoices Selection Form -->
    @if (Model.BuildingId > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-5">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-receipt-cutoff text-primary"></i> Danh sách hóa đơn nháp kỳ @Model.BillingMonth/@Model.BillingYear
                    </h2>
                    <span class="badge bg-light text-dark border">
                        @(Model.DraftInvoices.Count) hóa đơn chờ phát hành
                    </span>
                </div>

                @if (Model.DraftInvoices.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-all display-4 text-success mb-3"></i>
                        <h3 class="h5 fw-bold text-dark">Không có hóa đơn nháp nào</h3>
                        <p class="small mb-0">Tất cả hóa đơn trong kỳ này đã được phát hành hoặc chưa được tạo.</p>
                        <div class="mt-3">
                            <a asp-action="BatchCreateInvoices" asp-route-buildingId="@Model.BuildingId" asp-route-year="@Model.BillingYear" asp-route-month="@Model.BillingMonth" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-circle"></i> Lập hóa đơn mới
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <form asp-action="BatchIssueInvoices" method="post" id="batchIssueForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                        <input type="hidden" asp-for="BuildingId" />
                        <input type="hidden" asp-for="BillingYear" />
                        <input type="hidden" asp-for="BillingMonth" />

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="invoicesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" style="width: 48px;" class="text-center">
                                            <input type="checkbox" class="form-check-input" id="checkAll" checked />
                                        </th>
                                        <th scope="col" style="width: 120px;">Căn hộ</th>
                                        <th scope="col" style="width: 180px;">Chủ hộ</th>
                                        <th scope="col" style="width: 180px;">Mã hóa đơn</th>
                                        <th scope="col" class="text-end" style="width: 130px;">Phí QL</th>
                                        <th scope="col" class="text-end" style="width: 130px;">Tiền điện</th>
                                        <th scope="col" class="text-end" style="width: 130px;">Tiền nước</th>
                                        <th scope="col" class="text-end" style="width: 150px;">Tổng tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.DraftInvoices.Count; i++)
                                    {
                                        var inv = Model.DraftInvoices[i];
                                        <tr class="invoice-row">
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       asp-for="DraftInvoices[i].IsSelected"
                                                       class="form-check-input row-select"
                                                       data-amount="@inv.TotalAmount" />
                                                <input type="hidden" asp-for="DraftInvoices[i].InvoiceId" />
                                                <input type="hidden" asp-for="DraftInvoices[i].InvoiceCode" />
                                                <input type="hidden" asp-for="DraftInvoices[i].ApartmentCode" />
                                                <input type="hidden" asp-for="DraftInvoices[i].ResidentName" />
                                                <input type="hidden" asp-for="DraftInvoices[i].ManagementFee" />
                                                <input type="hidden" asp-for="DraftInvoices[i].ElectricityFee" />
                                                <input type="hidden" asp-for="DraftInvoices[i].WaterFee" />
                                                <input type="hidden" asp-for="DraftInvoices[i].TotalAmount" />
                                                <input type="hidden" asp-for="DraftInvoices[i].RowVersionToken" />
                                            </td>
                                            <td class="fw-semibold">@inv.ApartmentCode</td>
                                            <td>@inv.ResidentName</td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@inv.InvoiceId" class="text-decoration-none font-monospace small">
                                                    @inv.InvoiceCode
                                                </a>
                                            </td>
                                            <td class="text-end font-monospace">@inv.ManagementFee.ToString("N0") ₫</td>
                                            <td class="text-end font-monospace">@inv.ElectricityFee.ToString("N0") ₫</td>
                                            <td class="text-end font-monospace">@inv.WaterFee.ToString("N0") ₫</td>
                                            <td class="text-end fw-bold font-monospace text-primary">@inv.TotalAmount.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Sticky Floating Action Bar -->
                        <div class="position-sticky bottom-0 bg-white border-top shadow-lg p-3 rounded-bottom-4 mt-3 z-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <span class="text-muted small">Đã chọn:</span>
                                    <strong class="fs-5 text-primary" id="selectedCountText">0</strong> / @Model.DraftInvoices.Count căn hộ
                                    <span class="mx-2 text-muted">|</span>
                                    <span class="text-muted small">Tổng tiền:</span>
                                    <strong class="fs-5 text-success font-monospace" id="selectedAmountText">0 ₫</strong>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg d-inline-flex align-items-center gap-2" id="submitBtn">
                                        <i class="bi bi-send-check-fill"></i> Tiến hành phát hành
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkAll = document.getElementById('checkAll');
            const rowCheckboxes = document.querySelectorAll('.row-select');
            const selectedCountText = document.getElementById('selectedCountText');
            const selectedAmountText = document.getElementById('selectedAmountText');
            const submitBtn = document.getElementById('submitBtn');

            function updateSummary() {
                let count = 0;
                let total = 0;

                rowCheckboxes.forEach(cb => {
                    if (cb.checked) {
                        count++;
                        const amt = parseFloat(cb.getAttribute('data-amount')) || 0;
                        total += amt;
                    }
                });

                if (selectedCountText) selectedCountText.textContent = count;
                if (selectedAmountText) selectedAmountText.textContent = total.toLocaleString('vi-VN') + ' ₫';
                if (submitBtn) submitBtn.disabled = count === 0;

                if (checkAll && rowCheckboxes.length > 0) {
                    checkAll.checked = count === rowCheckboxes.length;
                    checkAll.indeterminate = count > 0 && count < rowCheckboxes.length;
                }
            }

            if (checkAll) {
                checkAll.addEventListener('change', function () {
                    rowCheckboxes.forEach(cb => cb.checked = checkAll.checked);
                    updateSummary();
                });
            }

            rowCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateSummary);
            });

            updateSummary();
        });
    </script>
}

