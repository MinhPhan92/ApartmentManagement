@model BillingIndexViewModel
@{
    ViewData["Title"] = "Phí và hóa đơn";
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h3 fw-bold mb-1">Phí và hóa đơn</h1><p class="text-muted mb-0">Cấu hình biểu phí, nhập chỉ số và phát hành hóa đơn.</p></div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="CreateTariff" class="btn btn-outline-primary">Thêm biểu phí</a>
            <a asp-action="RecordReading" class="btn btn-outline-primary">Ghi chỉ số</a>
            <a asp-action="CreateInvoice" class="btn btn-primary">Lập hóa đơn nháp</a>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div> }
    <section class="mb-5">
        <h2 class="h5 fw-bold mb-3">Hóa đơn</h2>
        @if (Model.Invoices.Count == 0)
        {
            <div class="alert alert-info">Chưa có hóa đơn.</div>
        }
        else
        {
            <div class="table-responsive bg-white rounded-4 shadow-sm">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Mã hóa đơn</th><th>Kỳ</th><th>Căn hộ</th><th>Cư dân</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceCode</td>
                            <td>@($"{invoice.BillingMonth:D2}/{invoice.BillingYear}")</td>
                            <td>@invoice.Apartment.Building?.BuildingName — @invoice.Apartment.ApartmentCode</td>
                            <td>@invoice.Resident.User.FullName</td>
                            <td>@invoice.TotalAmount.ToString("N0") đ</td>
                            <td>@StatusText(invoice.Status)</td>
                            <td><a asp-action="Details" asp-route-id="@invoice.ApartmentInvoiceId" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <section>
        <h2 class="h5 fw-bold mb-3">Biểu phí</h2>
        @if (Model.Tariffs.Count == 0)
        {
            <div class="alert alert-info">Chưa cấu hình biểu phí.</div>
        }
        else
        {
            <div class="table-responsive bg-white rounded-4 shadow-sm">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Tòa nhà</th><th>Loại phí</th><th>Hiệu lực từ</th><th>Đến</th><th>Đơn giá quản lý</th><th>Bậc giá</th></tr></thead>
                    <tbody>
                    @foreach (var tariff in Model.Tariffs)
                    {
                        <tr>
                            <td>@tariff.Building.BuildingName</td><td>@ChargeText(tariff.ChargeType)</td>
                            <td>@tariff.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                            <td>@(tariff.EffectiveTo?.ToString("dd/MM/yyyy") ?? "Không giới hạn")</td>
                            <td>@(tariff.ChargeType == FeeChargeType.Management ? $"{tariff.MonthlyRatePerSquareMeter:N0} đ/m²/tháng" : "—")</td>
                            <td>@(tariff.Tiers.Count == 0 ? "—" : string.Join(", ", tariff.Tiers.OrderBy(x => x.TierOrder).Select(x => $"{(x.UpperConsumption?.ToString("N0") ?? "+")} @ {x.UnitRate:N0} đ")))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
@functions {
    private static string ChargeText(FeeChargeType type) => type switch
    {
        FeeChargeType.Management => "Phí quản lý",
        FeeChargeType.Electricity => "Điện",
        FeeChargeType.Water => "Nước",
        _ => "Không xác định"
    };
    private static string StatusText(ApartmentInvoiceStatus status) => status switch
    {
        ApartmentInvoiceStatus.Draft => "Nháp",
        ApartmentInvoiceStatus.Issued => "Đã phát hành — chưa đối soát thanh toán",
        ApartmentInvoiceStatus.Void => "Đã hủy",
        _ => "Không xác định"
    };
}
