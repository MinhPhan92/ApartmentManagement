@model BillingIndexViewModel
@{
    ViewData["Title"] = "Quản lý phí & Hóa đơn";
    var summary = Model.Summary;
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Quản lý phí & Hóa đơn</h1>
            <p class="text-muted mb-0">Theo dõi biểu phí dịch vụ, ghi chỉ số điện nước, lập hóa đơn và quản lý công nợ cư dân.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="CreateTariff" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-tag-fill"></i> Thêm biểu phí
            </a>
            <a asp-action="RecordReading" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-speedometer2"></i> Ghi chỉ số lẻ
            </a>
            <a asp-action="RecordBatchReadings" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-speedometer"></i> Ghi chỉ số tòa nhà
            </a>
            <a asp-action="CreateInvoice" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-circle-fill"></i> Lập hóa đơn lẻ
            </a>
            <a asp-action="BatchCreateInvoices" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-collection-fill"></i> Lập hóa đơn tòa nhà
            </a>
            <a asp-action="BatchIssueInvoices" class="btn btn-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-send-check-fill"></i> Phát hành tòa nhà
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="status">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Metrics -->
    @if (summary != null)
    {
        var collectionRate = summary.TotalInvoiced > 0
            ? Math.Round(summary.TotalCollected / summary.TotalInvoiced * 100, 1)
            : 0;

        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Tổng phải thu (Đã phát hành)</span>
                                <h3 class="fw-bold mt-2 mb-1 text-primary">@summary.TotalInvoiced.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                                <span class="small text-muted">@summary.IssuedCount hóa đơn đã phát hành</span>
                            </div>
                            <div class="p-3 bg-primary-subtle text-primary rounded-4">
                                <i class="bi bi-receipt fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Đã thu (Xác nhận)</span>
                                <h3 class="fw-bold mt-2 mb-1 text-success">@summary.TotalCollected.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                                <span class="small text-success fw-medium">Tỷ lệ thu: @collectionRate%</span>
                            </div>
                            <div class="p-3 bg-success-subtle text-success rounded-4">
                                <i class="bi bi-check2-circle fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Dư nợ còn phải thu</span>
                                <h3 class="fw-bold mt-2 mb-1 text-danger">@summary.TotalReceivable.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                                <span class="small text-danger fw-medium">@summary.UnpaidCount hóa đơn chưa thu đủ</span>
                            </div>
                            <div class="p-3 bg-danger-subtle text-danger rounded-4">
                                <i class="bi bi-clock-history fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase">Tổng số hóa đơn</span>
                                <h3 class="fw-bold mt-2 mb-1">@summary.TotalInvoices</h3>
                                <div class="d-flex gap-2 small text-muted">
                                    <span>Nháp: <strong>@summary.DraftCount</strong></span>
                                    <span>·</span>
                                    <span>Hủy: <strong>@summary.VoidCount</strong></span>
                                </div>
                            </div>
                            <div class="p-3 bg-secondary-subtle text-secondary rounded-4">
                                <i class="bi bi-stack fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Invoices Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-lg-3">
                    <label for="buildingId" class="form-label small fw-semibold text-muted">Tòa nhà</label>
                    <select id="buildingId" name="buildingId" class="form-select">
                        <option value="">-- Tất cả tòa nhà --</option>
                        @foreach (var opt in Model.BuildingOptions)
                        {
                            <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2 col-lg-1">
                    <label for="month" class="form-label small fw-semibold text-muted">Tháng</label>
                    <input type="number" id="month" name="month" value="@Model.BillingMonth" min="1" max="12" class="form-control" placeholder="Tháng" />
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <label for="year" class="form-label small fw-semibold text-muted">Năm</label>
                    <input type="number" id="year" name="year" value="@Model.BillingYear" min="2000" max="2200" class="form-control" placeholder="Năm" />
                </div>
                <div class="col-12 col-md-4 col-lg-2">
                    <label for="status" class="form-label small fw-semibold text-muted">Trạng thái hóa đơn</label>
                    <select id="status" name="status" asp-items="Model.StatusOptions" class="form-select"></select>
                </div>
                <div class="col-12 col-md-4 col-lg-2">
                    <label for="paymentStatus" class="form-label small fw-semibold text-muted">Thanh toán</label>
                    <select id="paymentStatus" name="paymentStatus" asp-items="Model.PaymentStatusOptions" class="form-select"></select>
                </div>
                <div class="col-12 col-md-4 col-lg-2">
                    <label for="searchTerm" class="form-label small fw-semibold text-muted">Từ khóa</label>
                    <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Mã HĐ, căn hộ, cư dân" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-funnel-fill"></i> Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Section 1: Hóa đơn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h2 class="h5 fw-bold mb-0">Danh sách Hóa đơn & Khoản phải thu</h2>
            <span class="badge bg-light text-muted border">@Model.Invoices.Count kết quả</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã hóa đơn</th>
                        <th>Kỳ</th>
                        <th>Căn hộ</th>
                        <th>Cư dân</th>
                        <th>Hạn thanh toán</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-end">Đã thu</th>
                        <th class="text-end">Còn nợ</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thanh toán</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Invoices.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <span>Không tìm thấy hóa đơn nào phù hợp với bộ lọc.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var invoice in Model.Invoices)
                    {
                        var confirmedAmount = invoice.PaymentTransactions
                            .Where(x => x.Status == PaymentTransactionStatus.Confirmed)
                            .Sum(x => x.Amount);
                        var remainingBalance = invoice.Status == ApartmentInvoiceStatus.Void
                            ? 0m
                            : Math.Max(0m, invoice.TotalAmount - confirmedAmount);

                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@invoice.InvoiceCode</td>
                            <td><span class="badge bg-light text-dark border">@($"{invoice.BillingMonth:D2}/{invoice.BillingYear}")</span></td>
                            <td>@(invoice.Apartment.Building?.BuildingName ?? "Chung cư") — <strong>@invoice.Apartment.ApartmentCode</strong></td>
                            <td>@invoice.Resident.User.FullName</td>
                            <td>@invoice.DueDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end fw-semibold">@invoice.TotalAmount.ToString("N0") đ</td>
                            <td class="text-end text-success">@confirmedAmount.ToString("N0") đ</td>
                            <td class="text-end fw-bold @(remainingBalance > 0 ? "text-danger" : "text-muted")">
                                @remainingBalance.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @if (invoice.Status == ApartmentInvoiceStatus.Draft)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Bản nháp</span>
                                }
                                else if (invoice.Status == ApartmentInvoiceStatus.Issued)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã phát hành</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (invoice.Status == ApartmentInvoiceStatus.Void)
                                {
                                    <span class="badge bg-light text-muted">Vô hiệu</span>
                                }
                                else if (invoice.Status == ApartmentInvoiceStatus.Draft)
                                {
                                    <span class="badge bg-light text-muted">Chưa phát hành</span>
                                }
                                else if (confirmedAmount >= invoice.TotalAmount && invoice.TotalAmount > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đã thanh toán</span>
                                }
                                else if (invoice.PaymentTransactions.Any(x => x.Status == PaymentTransactionStatus.Pending))
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ xác nhận</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Chưa thanh toán</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@invoice.ApartmentInvoiceId" class="btn btn-sm btn-outline-primary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 2: Biểu phí -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 fw-bold mb-0">Cấu hình Biểu phí hiện có</h2>
                <small class="text-muted">Biểu phí được áp dụng theo tòa nhà, loại dịch vụ và khoảng thời gian hiệu lực.</small>
            </div>
            <a asp-action="CreateTariff" class="btn btn-sm btn-outline-primary">➕ Thêm biểu phí</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tòa nhà</th>
                        <th>Loại phí</th>
                        <th>Hiệu lực từ</th>
                        <th>Hiệu lực đến</th>
                        <th>Trạng thái</th>
                        <th>Đơn giá quản lý</th>
                        <th>Bậc giá tiêu thụ</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Tariffs.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i class="bi bi-tag fs-1 text-muted"></i>
                                <span>Chưa có biểu phí nào được thiết lập.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tariff in Model.Tariffs)
                    {
                        var today = DateTime.Today;
                        var isCurrent = tariff.EffectiveFrom.Date <= today && (!tariff.EffectiveTo.HasValue || tariff.EffectiveTo.Value >= today);
                        var isExpired = tariff.EffectiveTo.HasValue && tariff.EffectiveTo.Value < today;

                        <tr>
                            <td class="ps-4 fw-semibold">@tariff.Building.BuildingName</td>
                            <td>
                                <span class="badge @(tariff.ChargeType == FeeChargeType.Management ? "bg-info-subtle text-info border border-info-subtle" : tariff.ChargeType == FeeChargeType.Electricity ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                    @ChargeText(tariff.ChargeType)
                                </span>
                            </td>
                            <td>@tariff.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                            <td>@(tariff.EffectiveTo?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")</td>
                            <td>
                                @if (isCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đang áp dụng</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Hết hiệu lực</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Sắp áp dụng</span>
                                }
                            </td>
                            <td>@(tariff.ChargeType == FeeChargeType.Management ? $"{tariff.MonthlyRatePerSquareMeter:N0} đ/m²/tháng" : "—")</td>
                            <td>
                                @if (tariff.Tiers.Count == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <small class="text-muted">
                                        @string.Join("; ", tariff.Tiers.OrderBy(x => x.TierOrder).Select(x => $"{(x.UpperConsumption.HasValue ? $"0–{x.UpperConsumption:N0}" : "> trước")} @ {x.UnitRate:N0}đ"))
                                    </small>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="TariffDetails" asp-route-id="@tariff.FeeTariffId" class="btn btn-outline-primary">Chi tiết</a>
                                    @if (!tariff.EffectiveTo.HasValue || tariff.EffectiveTo.Value >= DateTime.Today)
                                    {
                                        <a asp-action="CloseTariff" asp-route-id="@tariff.FeeTariffId" class="btn btn-outline-secondary" title="Cập nhật ngày kết thúc hiệu lực">Đóng</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private static string ChargeText(FeeChargeType type) => type switch
    {
        FeeChargeType.Management => "Phí quản lý",
        FeeChargeType.Electricity => "Điện",
        FeeChargeType.Water => "Nước",
        _ => "Không xác định"
    };
}
