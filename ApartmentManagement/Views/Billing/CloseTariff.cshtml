@model CloseTariffViewModel
@{
    ViewData["Title"] = "Đóng / Cập nhật thời hạn biểu phí";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4 p-md-5">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index">Phí & Hóa đơn</a></li>
                    <li class="breadcrumb-item"><a asp-action="TariffDetails" asp-route-id="@Model.FeeTariffId">Biểu phí #@Model.FeeTariffId</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cập nhật thời hạn</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-2">Cập nhật ngày kết thúc biểu phí</h1>
            <p class="text-muted small mb-4">Thiết lập ngày kết thúc hiệu lực để đóng biểu phí cũ khi có biểu phí mới thay thế mà không làm ảnh hưởng đến dữ liệu hóa đơn lịch sử.</p>

            <form asp-action="CloseTariff" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>
                <input type="hidden" asp-for="FeeTariffId" />
                <input type="hidden" asp-for="BuildingName" />
                <input type="hidden" asp-for="ChargeType" />
                <input type="hidden" asp-for="EffectiveFrom" />

                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="row g-2 small">
                        <div class="col-sm-5 text-muted">Tòa nhà:</div>
                        <div class="col-sm-7 fw-semibold">@Model.BuildingName</div>
                        <div class="col-sm-5 text-muted">Loại biểu phí:</div>
                        <div class="col-sm-7 fw-semibold">@ChargeText(Model.ChargeType)</div>
                        <div class="col-sm-5 text-muted">Hiệu lực từ ngày:</div>
                        <div class="col-sm-7 fw-semibold">@Model.EffectiveFrom.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="EffectiveTo" class="form-label fw-semibold">Ngày kết thúc hiệu lực mới</label>
                    <input asp-for="EffectiveTo" class="form-control form-control-lg" type="date" min="@Model.EffectiveFrom.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EffectiveTo" class="text-danger small"></span>
                    <div class="form-text">Ngày kết thúc phải từ ngày bắt đầu hiệu lực (@Model.EffectiveFrom.ToString("dd/MM/yyyy")) trở đi.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning d-inline-flex align-items-center gap-1">
                        <i class="bi bi-check2-circle"></i> Xác nhận lưu thời hạn
                    </button>
                    <a asp-action="TariffDetails" asp-route-id="@Model.FeeTariffId" class="btn btn-outline-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string ChargeText(FeeChargeType type) => type switch
    {
        FeeChargeType.Management => "Phí quản lý",
        FeeChargeType.Electricity => "Điện",
        FeeChargeType.Water => "Nước",
        _ => "Không xác định"
    };
}
