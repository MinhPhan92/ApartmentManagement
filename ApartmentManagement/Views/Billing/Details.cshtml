@model ApartmentInvoice
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}
<div class="container py-4">
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div> }
    <article class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div><h1 class="h3 fw-bold">Hóa đơn @Model.InvoiceCode</h1><p class="text-muted">Kỳ @Model.BillingMonth.ToString("D2")/@Model.BillingYear</p></div>
                <span class="badge @(Model.Status == ApartmentInvoiceStatus.Issued ? "bg-success" : "bg-secondary") align-self-start">@Model.Status</span>
            </div>
            <dl class="row">
                <dt class="col-sm-3">Căn hộ</dt><dd class="col-sm-9">@Model.Apartment.Building?.BuildingName — @Model.Apartment.ApartmentCode</dd>
                <dt class="col-sm-3">Người nhận</dt><dd class="col-sm-9">@Model.Resident.User.FullName</dd>
                <dt class="col-sm-3">Diện tích chốt</dt><dd class="col-sm-9">@Model.ApartmentArea.ToString("N2") m²</dd>
                <dt class="col-sm-3">Hạn thanh toán</dt><dd class="col-sm-9">@Model.DueDate.ToString("dd/MM/yyyy")</dd>
            </dl>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Khoản phí</th><th class="text-end">Chỉ số</th><th class="text-end">Số lượng</th><th class="text-end">Đơn giá bình quân</th><th class="text-end">Thành tiền</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Description@if (line.RateBreakdown != null) { <small class="d-block text-muted">@line.RateBreakdown</small> }</td>
                            <td class="text-end">@(line.PreviousReading.HasValue ? $"{line.PreviousReading:N4} → {line.CurrentReading:N4}" : "—")</td>
                            <td class="text-end">@line.Quantity.ToString("N4")</td><td class="text-end">@line.UnitRate.ToString("N4") đ</td><td class="text-end">@line.Amount.ToString("N0") đ</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr class="fw-bold"><td colspan="4" class="text-end">Tổng cộng</td><td class="text-end">@Model.TotalAmount.ToString("N0") đ</td></tr></tfoot>
                </table>
            </div>
            @if (Model.Status == ApartmentInvoiceStatus.Draft)
            {
                <form asp-action="Issue" method="post" class="mt-3">
                    <input type="hidden" name="InvoiceId" value="@Model.ApartmentInvoiceId" />
                    <input type="hidden" name="RowVersionToken" value="@Convert.ToBase64String(Model.RowVersion)" />
                    <button type="submit" class="btn btn-success">Phát hành cho cư dân</button>
                </form>
            }
            else if (Model.Status == ApartmentInvoiceStatus.Issued)
            {
                <p class="alert alert-warning mb-0">Khoản phải thu: @Model.TotalAmount.ToString("N0") đ — chưa có tích hợp thanh toán hoặc đối soát.</p>
            }
            <a asp-action="Index" class="btn btn-outline-secondary mt-3">Quay lại</a>
        </div>
    </article>
</div>
