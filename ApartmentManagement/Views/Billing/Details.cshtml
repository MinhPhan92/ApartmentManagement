@model ApartmentInvoice
@{
    ViewData["Title"] = $"Chi tiết hóa đơn {Model.InvoiceCode}";
    var confirmedAmount = Model.PaymentTransactions
        .Where(x => x.Status == PaymentTransactionStatus.Confirmed)
        .Sum(x => x.Amount);
    var remainingBalance = Model.Status == ApartmentInvoiceStatus.Void
        ? 0m
        : Math.Max(0m, Model.TotalAmount - confirmedAmount);
    var hasConfirmedPayment = confirmedAmount > 0;
    var rowVersionToken = Convert.ToBase64String(Model.RowVersion);
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Header breadcrumb & navigation -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Phí & Hóa đơn</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết hóa đơn</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">Hóa đơn @Model.InvoiceCode</h1>
            <p class="text-muted small mb-0">
                Kỳ tính phí: <strong>@($"{Model.BillingMonth:D2}/{Model.BillingYear}")</strong> · Căn hộ: <strong>@(Model.Apartment.Building?.BuildingName ?? "Chung cư") — @Model.Apartment.ApartmentCode</strong>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Status == ApartmentInvoiceStatus.Draft)
            {
                <button type="button" class="btn btn-success d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#issueInvoiceModal">
                    <i class="bi bi-send-check-fill"></i> Phát hành cho cư dân
                </button>
                <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#voidInvoiceModal">
                    <i class="bi bi-x-circle-fill"></i> Hủy hóa đơn
                </button>
            }
            else if (Model.Status == ApartmentInvoiceStatus.Issued && !hasConfirmedPayment)
            {
                <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#voidInvoiceModal">
                    <i class="bi bi-x-circle-fill"></i> Hủy hóa đơn
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="status">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Financial KPI Cards for this Invoice -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng giá trị hóa đơn</span>
                    <h3 class="fw-bold mt-2 mb-1 text-primary">@Model.TotalAmount.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                    <span class="small text-muted">Bao gồm phí quản lý và điện nước</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Đã thanh toán (Xác nhận)</span>
                    <h3 class="fw-bold mt-2 mb-1 text-success">@confirmedAmount.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                    <span class="small text-success fw-medium">
                        @(confirmedAmount >= Model.TotalAmount && Model.TotalAmount > 0 ? "Đã thanh toán đủ 100%" : "Chưa hoàn tất thanh toán")
                    </span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Số dư còn phải thu</span>
                    <h3 class="fw-bold mt-2 mb-1 @(remainingBalance > 0 ? "text-danger" : "text-muted")">
                        @remainingBalance.ToString("N0") <small class="fs-6 text-muted">đ</small>
                    </h3>
                    <span class="small @(remainingBalance > 0 ? "text-danger" : "text-muted") fw-medium">
                        Hạn thanh toán: @Model.DueDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column: Line items and breakdown -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h5 fw-bold mb-0">Chi tiết các khoản phí</h2>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Khoản phí & Diễn giải</th>
                                <th class="text-end">Chỉ số đầu → cuối</th>
                                <th class="text-end">Số lượng</th>
                                <th class="text-end">Đơn giá BQ</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@line.Description</div>
                                    @if (!string.IsNullOrWhiteSpace(line.RateBreakdown))
                                    {
                                        <small class="text-muted d-block font-monospace">@line.RateBreakdown</small>
                                    }
                                </td>
                                <td class="text-end font-monospace">
                                    @(line.PreviousReading.HasValue ? $"{line.PreviousReading:N2} → {line.CurrentReading:N2}" : "—")
                                </td>
                                <td class="text-end">@line.Quantity.ToString("N2")</td>
                                <td class="text-end">@line.UnitRate.ToString("N2") đ</td>
                                <td class="text-end pe-4 fw-semibold">@line.Amount.ToString("N0") đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="4" class="ps-4 text-end">Tổng cộng khoản phí:</td>
                                <td class="text-end pe-4 text-primary fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Payment Transaction History -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h2 class="h5 fw-bold mb-0">Lịch sử giao dịch thanh toán</h2>
                    <span class="badge bg-light text-muted border">@Model.PaymentTransactions.Count giao dịch</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.PaymentTransactions.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-credit-card-2-front fs-2 d-block mb-2 text-muted"></i>
                            <span>Chưa có giao dịch thanh toán nào được khởi tạo cho hóa đơn này.</span>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Mã tham chiếu</th>
                                        <th class="text-end">Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Thời điểm tạo</th>
                                        <th>Thời điểm xác nhận</th>
                                        <th class="pe-4">Người xác nhận</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var payment in Model.PaymentTransactions)
                                {
                                    <tr>
                                        <td class="ps-4 font-monospace fw-semibold text-primary">@payment.Reference</td>
                                        <td class="text-end fw-semibold text-success">@payment.Amount.ToString("N0") đ</td>
                                        <td>
                                            @if (payment.Status == PaymentTransactionStatus.Confirmed)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã xác nhận mô phỏng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ đối soát</span>
                                            }
                                        </td>
                                        <td>@payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(payment.ConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                        <td class="pe-4">@(payment.ConfirmedByUser?.FullName ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Summary & Metadata -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h6 fw-bold mb-0">Thông tin chung</h2>
                </div>
                <div class="card-body p-4 pt-0">
                    <dl class="row mb-0 g-2">
                        <dt class="col-sm-5 text-muted small">Trạng thái HĐ:</dt>
                        <dd class="col-sm-7 fw-semibold">
                            @if (Model.Status == ApartmentInvoiceStatus.Draft)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Bản nháp</span>
                            }
                            else if (Model.Status == ApartmentInvoiceStatus.Issued)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã phát hành</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted small">Căn hộ:</dt>
                        <dd class="col-sm-7 fw-semibold">@(Model.Apartment.Building?.BuildingName ?? "Chung cư") — @Model.Apartment.ApartmentCode</dd>

                        <dt class="col-sm-5 text-muted small">Cư dân nhận:</dt>
                        <dd class="col-sm-7">@Model.Resident.User.FullName</dd>

                        <dt class="col-sm-5 text-muted small">Diện tích tính phí:</dt>
                        <dd class="col-sm-7">@Model.ApartmentArea.ToString("N2") m²</dd>

                        <dt class="col-sm-5 text-muted small">Hạn thanh toán:</dt>
                        <dd class="col-sm-7 fw-semibold text-danger">@Model.DueDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-5 text-muted small">Ngày lập nháp:</dt>
                        <dd class="col-sm-7">@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                        @if (Model.IssuedAtUtc.HasValue)
                        {
                            <dt class="col-sm-5 text-muted small">Ngày phát hành:</dt>
                            <dd class="col-sm-7">@Model.IssuedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                            <dt class="col-sm-5 text-muted small">Người phát hành:</dt>
                            <dd class="col-sm-7">@(Model.IssuedByUser?.FullName ?? Model.IssuedByUserId ?? "—")</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- Status Notice Box -->
            @if (Model.Status == ApartmentInvoiceStatus.Draft)
            {
                <div class="card border-0 bg-warning-subtle text-warning-emphasis rounded-4 p-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-info-circle-fill fs-4 flex-shrink-0"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Hóa đơn nháp</h6>
                            <p class="small mb-0">Hóa đơn ở trạng thái nháp chưa hiển thị trong cổng thông tin của cư dân. Vui lòng rà soát chỉ số và các dòng phí trước khi phát hành.</p>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Status == ApartmentInvoiceStatus.Void)
            {
                <div class="card border-0 bg-danger-subtle text-danger-emphasis rounded-4 p-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-exclamation-octagon-fill fs-4 flex-shrink-0"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Hóa đơn đã bị hủy</h6>
                            <p class="small mb-0">Hóa đơn này đã vô hiệu và không còn phát sinh nghĩa vụ công nợ đối với cư dân.</p>
                        </div>
                    </div>
                </div>
            }
            else if (hasConfirmedPayment)
            {
                <div class="card border-0 bg-success-subtle text-success-emphasis rounded-4 p-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-check-circle-fill fs-4 flex-shrink-0"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Đã hoàn tất thanh toán</h6>
                            <p class="small mb-0">Hóa đơn đã có giao dịch thanh toán được xác nhận mô phỏng bởi Ban quản lý.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 bg-primary-subtle text-primary-emphasis rounded-4 p-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-clock-fill fs-4 flex-shrink-0"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Đang chờ thanh toán</h6>
                            <p class="small mb-0">Hóa đơn đã được phát hành cho cư dân và đang trong thời hạn chờ thanh toán.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Phát hành hóa đơn -->
@if (Model.Status == ApartmentInvoiceStatus.Draft)
{
    <div class="modal fade" id="issueInvoiceModal" tabindex="-1" aria-labelledby="issueInvoiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="issueInvoiceModalLabel">Xác nhận phát hành hóa đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Issue" method="post">
                    <div class="modal-body py-4">
                        <p class="mb-2">Bạn có chắc chắn muốn phát hành hóa đơn <strong>@Model.InvoiceCode</strong> cho cư dân <strong>@Model.Resident.User.FullName</strong> không?</p>
                        <p class="text-muted small mb-0">Sau khi phát hành, hóa đơn sẽ hiển thị trên ứng dụng của cư dân với tổng số tiền là <strong>@Model.TotalAmount.ToString("N0") đ</strong>.</p>
                        <input type="hidden" name="InvoiceId" value="@Model.ApartmentInvoiceId" />
                        <input type="hidden" name="RowVersionToken" value="@rowVersionToken" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-success">Phát hành ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Hủy hóa đơn -->
@if (Model.Status != ApartmentInvoiceStatus.Void && !hasConfirmedPayment)
{
    <div class="modal fade" id="voidInvoiceModal" tabindex="-1" aria-labelledby="voidInvoiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="voidInvoiceModalLabel">Xác nhận hủy hóa đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Void" method="post">
                    <div class="modal-body py-4">
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle-fill"></i> Thao tác này sẽ hủy bỏ hóa đơn và không thể hoàn tác. Mọi giao dịch chờ xử lý liên quan sẽ bị loại bỏ.
                        </div>
                        <p class="mb-3">Bạn đang hủy hóa đơn: <strong>@Model.InvoiceCode</strong></p>
                        <div class="mb-2">
                            <label for="voidReason" class="form-label small fw-semibold">Lý do hủy hóa đơn (tùy chọn):</label>
                            <textarea id="voidReason" name="Reason" class="form-control" rows="3" placeholder="Nhập lý do hủy hóa đơn..."></textarea>
                        </div>
                        <input type="hidden" name="InvoiceId" value="@Model.ApartmentInvoiceId" />
                        <input type="hidden" name="RowVersionToken" value="@rowVersionToken" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
