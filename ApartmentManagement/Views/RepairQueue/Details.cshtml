@model ApartmentManagement.Models.RepairRequest

@{
    ViewData["Title"] = $"Chi tiết yêu cầu #{Model.RepairRequestId} — Hàng đợi";
    var rowVersionBase64 = Convert.ToBase64String(Model.RowVersion);
    var activeAssignment = Model.Assignments.FirstOrDefault(a => a.Status != ApartmentManagement.Models.RepairAssignmentStatus.Reassigned);
    var canAssign = (bool)(ViewBag.CanAssign ?? false);
    var myActiveAssignment = ViewBag.MyActiveAssignment as ApartmentManagement.Models.RepairAssignment;
}

<div class="container py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Hàng đợi sửa chữa</a></li>
                <li class="breadcrumb-item active" aria-current="page">#REQ-@Model.RepairRequestId.ToString("D4")</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge @ApartmentManagement.Models.RepairRequestStatus.ToBadgeClass(Model.Status) fs-6">
                        @ApartmentManagement.Models.RepairRequestStatus.ToDisplayName(Model.Status)
                    </span>
                    <span class="badge @ApartmentManagement.Models.RepairPriority.ToBadgeClass(Model.Priority) fs-6">
                        Ưu tiên: @ApartmentManagement.Models.RepairPriority.ToDisplayName(Model.Priority)
                    </span>
                </div>
                <h2 class="fw-bold mb-0">#REQ-@Model.RepairRequestId.ToString("D4"): @Model.Title</h2>
            </div>
            <div class="d-flex gap-2">
                @if (canAssign && Model.Status != ApartmentManagement.Models.RepairRequestStatus.Completed && Model.Status != ApartmentManagement.Models.RepairRequestStatus.Cancelled)
                {
                    <a asp-action="Assign" asp-route-id="@Model.RepairRequestId" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-person-plus me-1"></i> @(activeAssignment == null ? "Phân công kỹ thuật viên" : "Đổi kỹ thuật viên")
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BANNER HÀNH ĐỘNG DÀNH CHO KỸ THUẬT VIÊN ĐƯỢC GIAO VIỆC -->
    @if (myActiveAssignment != null)
    {
        <div class="card border-0 shadow-sm rounded-4 border-start border-primary border-4 mb-4 bg-primary-subtle">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h5 class="fw-bold text-primary mb-1">🛠️ Bạn đang phụ trách yêu cầu này!</h5>
                        <p class="text-dark mb-0">Trạng thái phân công: <strong class="badge bg-primary">@ApartmentManagement.Models.RepairAssignmentStatus.ToDisplayName(myActiveAssignment.Status)</strong></p>
                    </div>
                    <div class="d-flex gap-2">
                        @if (myActiveAssignment.Status == ApartmentManagement.Models.RepairAssignmentStatus.Assigned)
                        {
                            <form asp-action="StartWork" asp-route-assignmentId="@myActiveAssignment.AssignmentId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowVersionBase64" value="@rowVersionBase64" />
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-play-fill me-1"></i> Tiếp nhận & Bắt đầu sửa
                                </button>
                            </form>
                        }
                        else if (myActiveAssignment.Status == ApartmentManagement.Models.RepairAssignmentStatus.InProgress)
                        {
                            <a asp-action="CompleteWork" asp-route-assignmentId="@myActiveAssignment.AssignmentId" class="btn btn-success rounded-pill px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Báo cáo kết quả hoàn thành
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <!-- Chi tiết sự cố & kết quả -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">📄 Chi Tiết Yêu Cầu</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">Nội dung sự cố:</label>
                        <div class="p-3 bg-light rounded-3 text-dark mt-1" style="white-space: pre-line;">@Model.Description</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Result))
                    {
                        <div class="mb-3">
                            <label class="text-muted small fw-semibold">Kết quả sửa chữa từ KTV:</label>
                            <div class="p-3 bg-success-subtle rounded-3 text-dark mt-1 border border-success-subtle">
                                <div class="fw-semibold text-success mb-1">
                                    <i class="bi bi-check-all me-1"></i> KTV hoàn thành lúc: @(Model.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </div>
                                <div style="white-space: pre-line;">@Model.Result</div>
                            </div>
                        </div>
                    }

                    @if (Model.Rating.HasValue)
                    {
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-semibold text-dark">Nghiệm thu & Đánh giá từ cư dân:</span>
                                <span class="text-warning fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Model.Rating.Value)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">☆</span>
                                        }
                                    }
                                </span>
                                <span class="fw-bold text-dark">(@Model.Rating / 5 sao)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.ResidentFeedback))
                            {
                                <div class="text-muted small fst-italic">“@Model.ResidentFeedback”</div>
                            }
                            <div class="small text-muted mt-1">Nghiệm thu lúc: @Model.ConfirmedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bảng Lịch sử phân công kỹ thuật viên (1-N) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">👥 Lịch Sử Phân Công Kỹ Thuật Viên</h5>
                    @if (canAssign && Model.Status != ApartmentManagement.Models.RepairRequestStatus.Completed && Model.Status != ApartmentManagement.Models.RepairRequestStatus.Cancelled)
                    {
                        <a asp-action="Assign" asp-route-id="@Model.RepairRequestId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-person-plus me-1"></i> Phân công lại
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Assignments != null && Model.Assignments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="ps-3">Kỹ thuật viên</th>
                                        <th>Thời điểm giao</th>
                                        <th>Thời điểm xong</th>
                                        <th>Trạng thái</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assign in Model.Assignments.OrderByDescending(a => a.AssignedAt))
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">
                                                @(assign.TechnicianUser?.FullName ?? "N/A")
                                                <div class="text-muted" style="font-size: 0.75rem;">@(assign.TechnicianUser?.Email ?? "")</div>
                                            </td>
                                            <td>@assign.AssignedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(assign.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                            <td>
                                                <span class="badge @(assign.Status == ApartmentManagement.Models.RepairAssignmentStatus.Completed ? "bg-success" : assign.Status == ApartmentManagement.Models.RepairAssignmentStatus.InProgress ? "bg-primary" : assign.Status == ApartmentManagement.Models.RepairAssignmentStatus.Reassigned ? "bg-secondary" : "bg-warning text-dark")">
                                                    @ApartmentManagement.Models.RepairAssignmentStatus.ToDisplayName(assign.Status)
                                                </span>
                                            </td>
                                            <td class="text-muted" style="max-width: 200px;">@(string.IsNullOrWhiteSpace(assign.Note) ? "—" : assign.Note)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-muted text-center">Chưa có phân công kỹ thuật viên nào.</div>
                    }
                </div>
            </div>

            <!-- Timeline Lịch sử chuyển trạng thái -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">⏱️ Lịch Sử Chuyển Trạng Thái</h5>
                </div>
                <div class="card-body pt-0">
                    @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                    {
                        <div class="timeline">
                            @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                            {
                                <div class="border-start border-2 border-primary ps-3 pb-3 position-relative">
                                    <div class="position-absolute rounded-circle bg-primary" style="width: 10px; height: 10px; left: -6px; top: 5px;"></div>
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="badge @ApartmentManagement.Models.RepairRequestStatus.ToBadgeClass(history.NewStatus)">
                                            @ApartmentManagement.Models.RepairRequestStatus.ToDisplayName(history.NewStatus)
                                        </span>
                                        <span class="small text-muted">@history.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="small fw-semibold text-dark mt-1">
                                        Người thực hiện: @(history.ChangedByUser?.FullName ?? "Hệ thống")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(history.Note))
                                    {
                                        <div class="small text-muted mt-1 bg-light p-2 rounded-2">@history.Note</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Chưa có bản ghi lịch sử.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin Căn hộ & Cư dân -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">🏢 Căn Hộ & Cư Dân</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="row g-2 small">
                        <div class="col-5 text-muted">Căn hộ:</div>
                        <div class="col-7 fw-semibold text-dark">@Model.Apartment?.ApartmentCode</div>

                        <div class="col-5 text-muted">Tòa nhà:</div>
                        <div class="col-7 fw-semibold text-dark">@Model.Apartment?.Building?.BuildingName</div>

                        <div class="col-5 text-muted">Tầng:</div>
                        <div class="col-7 text-dark">@Model.Apartment?.Floor</div>

                        <div class="col-5 text-muted">Cư dân:</div>
                        <div class="col-7 fw-semibold text-dark">@(Model.Resident?.User?.FullName ?? "N/A")</div>

                        <div class="col-5 text-muted">Số điện thoại:</div>
                        <div class="col-7 text-dark">📞 @(Model.Resident?.User?.PhoneNumber ?? "Chưa có")</div>

                        <div class="col-5 text-muted">Email:</div>
                        <div class="col-7 text-dark">@(Model.Resident?.User?.Email ?? "N/A")</div>

                        <div class="col-5 text-muted">Thời điểm gửi:</div>
                        <div class="col-7 text-dark">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <!-- Kỹ thuật viên hiện tại -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">👷 Kỹ Thuật Viên Đang Giao</h5>
                </div>
                <div class="card-body pt-0">
                    @if (activeAssignment?.TechnicianUser != null)
                    {
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                @(activeAssignment.TechnicianUser.FullName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <div class="fw-bold text-dark">@activeAssignment.TechnicianUser.FullName</div>
                                <div class="small text-muted">@activeAssignment.TechnicianUser.Email</div>
                                <span class="badge bg-light text-muted border small mt-1">
                                    Trạng thái việc: @ApartmentManagement.Models.RepairAssignmentStatus.ToDisplayName(activeAssignment.Status)
                                </span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(activeAssignment.Note))
                        {
                            <div class="small text-muted bg-light p-2 rounded-2 mt-2">
                                <strong>Ghi chú:</strong> @activeAssignment.Note
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="bi bi-person-x fs-2 d-block mb-1"></i>
                            <span>Chưa phân công kỹ thuật viên</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
