@model ResidentPaymentTransactionDetailsViewModel
@{
    var tx = Model.Transaction;
    var invoice = Model.Invoice;
    ViewData["Title"] = $"Giao dịch {tx.Reference}";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Hóa đơn của tôi</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@invoice.ApartmentInvoiceId">@invoice.InvoiceCode</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@tx.Reference</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">Chi tiết giao dịch @tx.Reference</h1>
            <p class="text-muted small mb-0">
                Hóa đơn: <strong>@invoice.InvoiceCode</strong> · Kỳ: <strong>@($"{invoice.BillingMonth:D2}/{invoice.BillingYear}")</strong>
            </p>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@invoice.ApartmentInvoiceId" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Quay lại hóa đơn
            </a>
        </div>
    </div>

    @if (tx.Status == PaymentTransactionStatus.Rejected)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4">
            <div class="d-flex gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Model.ReconciliationWarningMessage</div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h5 fw-bold mb-0">Thông tin giao dịch</h2>
                </div>
                <div class="card-body p-4 pt-0">
                    <dl class="row g-3 mb-0">
                        <dt class="col-sm-5 text-muted">Mã tham chiếu:</dt>
                        <dd class="col-sm-7 font-monospace fw-bold text-primary">@tx.Reference</dd>

                        <dt class="col-sm-5 text-muted">Số tiền:</dt>
                        <dd class="col-sm-7 fw-bold text-success fs-5">@tx.Amount.ToString("N0") đ</dd>

                        <dt class="col-sm-5 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-7">
                            @if (tx.Status == PaymentTransactionStatus.Confirmed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã xác nhận</span>
                            }
                            else if (tx.Status == PaymentTransactionStatus.Pending)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đang chờ xác nhận</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã từ chối</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted">Thời điểm tạo (UTC):</dt>
                        <dd class="col-sm-7">@tx.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC (@tx.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</dd>

                        @if (tx.Status == PaymentTransactionStatus.Confirmed)
                        {
                            <dt class="col-sm-5 text-muted">Thời điểm xác nhận:</dt>
                            <dd class="col-sm-7">@(tx.ConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>

                            <dt class="col-sm-5 text-muted">Người xác nhận:</dt>
                            <dd class="col-sm-7">@(tx.ConfirmedByUser?.FullName ?? tx.ConfirmedByUserId ?? "Ban quản lý")</dd>
                        }
                        else if (tx.Status == PaymentTransactionStatus.Rejected)
                        {
                            <dt class="col-sm-5 text-muted">Thời điểm từ chối:</dt>
                            <dd class="col-sm-7">@(tx.RejectedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>

                            <dt class="col-sm-5 text-muted">Người từ chối:</dt>
                            <dd class="col-sm-7">@(tx.RejectedByUser?.FullName ?? tx.RejectedByUserId ?? "Ban quản lý")</dd>

                            <dt class="col-sm-5 text-muted">Lý do từ chối:</dt>
                            <dd class="col-sm-7 text-danger fw-semibold">@(tx.RejectionReason ?? "—")</dd>
                        }
                        else
                        {
                            <dt class="col-sm-5 text-muted">Tình trạng xử lý:</dt>
                            <dd class="col-sm-7 text-warning-emphasis">Đang chờ Ban quản lý / Kế toán kiểm tra sao kê và xác nhận thủ công.</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h5 fw-bold mb-0">Thông tin chuyển khoản VietQR</h2>
                </div>
                <div class="card-body p-4 pt-0">
                    @if (Model.CanShowVietQr)
                    {
                        <div class="text-center mb-3">
                            <div class="bg-white p-3 rounded-3 shadow-sm border d-inline-block mb-2">
                                <img src="@Url.Action("PaymentQr", "MyInvoices", new { id = tx.PaymentTransactionId })"
                                     alt="Mã VietQR giao dịch @tx.Reference" class="img-fluid" style="max-width: 220px;" />
                            </div>
                        </div>
                    }
                    @if (Model.VietQrOptions is { IsConfigured: true })
                    {
                        <div class="bg-light rounded-3 p-3 small mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Ngân hàng:</span>
                                <span class="fw-semibold">@Model.VietQrOptions.BankName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Số tài khoản:</span>
                                <span class="font-monospace fw-bold">@Model.VietQrOptions.AccountNumber</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Chủ tài khoản:</span>
                                <span class="fw-semibold">@Model.VietQrOptions.AccountName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Số tiền:</span>
                                <span class="fw-bold text-success">@tx.Amount.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Nội dung CK:</span>
                                <span class="font-monospace fw-bold text-primary">@tx.Reference</span>
                            </div>
                        </div>
                    }
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle-fill"></i> @Model.QrDisclaimerMessage
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

