@model ResidentInvoiceDetailsViewModel
@{
    var invoice = Model.Invoice;
    ViewData["Title"] = $"Hóa đơn {invoice.InvoiceCode}";
    var isConfirmed = Model.Payment?.Status == PaymentTransactionStatus.Confirmed;
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Hóa đơn của tôi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@invoice.InvoiceCode</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">Hóa đơn @invoice.InvoiceCode</h1>
            <p class="text-muted small mb-0">
                Kỳ: <strong>@($"{invoice.BillingMonth:D2}/{invoice.BillingYear}")</strong> · Căn hộ: <strong>@(invoice.Apartment.Building?.BuildingName ?? "Chung cư") — @invoice.Apartment.ApartmentCode</strong>
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="status">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Status Banner -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số tiền phải nộp</span>
                    <h3 class="fw-bold mt-2 mb-1 text-primary">@invoice.TotalAmount.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                    <span class="small text-muted">Đã bao gồm tất cả các khoản phí</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Hạn thanh toán</span>
                    <h3 class="fw-bold mt-2 mb-1 text-danger">@invoice.DueDate.ToString("dd/MM/yyyy")</h3>
                    <span class="small text-muted">Vui lòng hoàn tất trước ngày đến hạn</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <span class="text-muted small fw-semibold text-uppercase">Trạng thái thanh toán</span>
                    <div class="mt-2">
                        @if (isConfirmed)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i> Đã thanh toán đủ
                            </span>
                        }
                        else if (Model.Payment != null)
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-hourglass-split"></i> Đang chờ Ban quản lý xác nhận
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-exclamation-circle-fill"></i> Chưa thanh toán
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column: Charges breakdown -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h5 fw-bold mb-0">Chi tiết các khoản phí trong kỳ</h2>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Khoản phí</th>
                                <th class="text-end">Chỉ số</th>
                                <th class="text-end">Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in invoice.Lines)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@line.Description</div>
                                    @if (!string.IsNullOrWhiteSpace(line.RateBreakdown))
                                    {
                                        <small class="text-muted d-block font-monospace">@line.RateBreakdown</small>
                                    }
                                </td>
                                <td class="text-end font-monospace">
                                    @(line.PreviousReading.HasValue ? $"{line.PreviousReading:N2} → {line.CurrentReading:N2}" : "—")
                                </td>
                                <td class="text-end">@line.Quantity.ToString("N2")</td>
                                <td class="text-end pe-4 fw-semibold">@line.Amount.ToString("N0") đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="3" class="ps-4 text-end">Tổng phải nộp:</td>
                                <td class="text-end pe-4 text-primary fs-5">@invoice.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Payment & VietQR -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h2 class="h5 fw-bold mb-0">Thanh toán qua chuyển khoản / VietQR</h2>
                </div>
                <div class="card-body p-4 pt-0">
                    @if (isConfirmed)
                    {
                        <div class="alert alert-success border-0 rounded-4 p-4 text-center">
                            <i class="bi bi-patch-check-fill text-success fs-1 d-block mb-2"></i>
                            <h5 class="fw-bold">Đã xác nhận thanh toán!</h5>
                            <p class="small text-muted mb-2">Mã tham chiếu: <strong class="font-monospace">@Model.Payment!.Reference</strong></p>
                            <p class="small text-muted mb-0">Cảm ơn bạn đã hoàn tất nghĩa vụ phí đúng hạn.</p>
                        </div>
                    }
                    else if (Model.Payment != null)
                    {
                        <div class="p-3 bg-light rounded-4 text-center mb-3">
                            <div class="mb-2">
                                <span class="text-muted small">Mã tham chiếu chuyển khoản:</span>
                                <div class="font-monospace fw-bold text-primary fs-5">@Model.Payment.Reference</div>
                            </div>
                            <div class="mb-3">
                                <span class="text-muted small">Số tiền cần chuyển:</span>
                                <div class="fw-bold text-success fs-4">@Model.Payment.Amount.ToString("N0") đ</div>
                            </div>

                            @if (Model.VietQrConfigured)
                            {
                                <div class="bg-white p-3 rounded-3 shadow-sm d-inline-block mb-2">
                                    <img src="@Url.Action("PaymentQr", "MyInvoices", new { id = Model.Payment.PaymentTransactionId })"
                                         alt="Mã VietQR thanh toán phí" class="img-fluid" style="max-width: 240px;" />
                                </div>
                                <p class="small text-muted mb-0">Mở ứng dụng Ngân hàng để quét mã QR và thanh toán tự động.</p>
                            }
                            else
                            {
                                <div class="alert alert-warning small mb-0">
                                    Chưa cấu hình tài khoản nhận VietQR của tòa nhà. Vui lòng liên hệ Ban quản lý.
                                </div>
                            }
                        </div>

                        <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 small">
                            <i class="bi bi-info-circle-fill"></i> <strong>Lưu ý:</strong> Hệ thống sử dụng đối soát mô phỏng. Sau khi chuyển khoản, nhân viên Ban quản lý sẽ kiểm tra và xác nhận thủ công trên hệ thống.
                        </div>
                    }
                    else if (Model.VietQrConfigured && Model.VietQrAmountSupported)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-qr-code-scan fs-1 text-primary d-block mb-3"></i>
                            <h6 class="fw-bold">Tạo mã VietQR cho hóa đơn này</h6>
                            <p class="text-muted small mb-4">Nhấn nút bên dưới để sinh mã chuyển khoản nhanh kèm nội dung và số tiền tự động.</p>
                            <form asp-action="CreateSimulatedPayment" method="post">
                                <input type="hidden" name="id" value="@invoice.ApartmentInvoiceId" />
                                <button type="submit" class="btn btn-primary btn-lg d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-qr-code"></i> Tạo mã QR chuyển khoản
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info border-0 rounded-4 p-4 text-center">
                            <i class="bi bi-info-circle fs-2 d-block mb-2 text-primary"></i>
                            @(invoice.TotalAmount <= 0
                                ? "Hóa đơn này không có số tiền cần thanh toán."
                                : !Model.VietQrAmountSupported
                                    ? "Số tiền hóa đơn vượt quá giới hạn hỗ trợ sinh mã VietQR."
                                : "Chức năng thanh toán qua mã QR hiện chưa được thiết lập tài khoản nhận. Vui lòng thanh toán trực tiếp tại văn phòng Ban quản lý.")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
