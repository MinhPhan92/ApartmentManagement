@model ApartmentManagement.Models.Building

@{
    ViewData["Title"] = "Thêm Tòa Nhà Mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-3">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Tòa Nhà</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 px-4 bg-gradient" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h4 class="fw-bold mb-1">🏢 Thêm Tòa Nhà Mới</h4>
                    <p class="mb-0 text-white-50 small">Khởi tạo thông tin tòa nhà trong khuôn viên chung cư</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BuildingCode" class="form-label fw-semibold text-secondary small">Mã Tòa Nhà <span class="text-danger">*</span></label>
                                <input asp-for="BuildingCode" class="form-control" placeholder="VD: BLOCK-A, T01" style="text-transform: uppercase;" />
                                <span asp-validation-for="BuildingCode" class="text-danger small"></span>
                                <div class="form-text small">Mã định danh duy nhất (không được trùng).</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BuildingName" class="form-label fw-semibold text-secondary small">Tên Tòa Nhà <span class="text-danger">*</span></label>
                                <input asp-for="BuildingName" class="form-control" placeholder="VD: Tòa Tháp Ruby, Block Sapphire" />
                                <span asp-validation-for="BuildingName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NumberOfFloors" class="form-label fw-semibold text-secondary small">Số Tầng <span class="text-danger">*</span></label>
                                <input asp-for="NumberOfFloors" type="number" min="1" max="200" class="form-control" />
                                <span asp-validation-for="NumberOfFloors" class="text-danger small"></span>
                                <div class="form-text small">Số tầng nổi tính từ tầng 1.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-semibold text-secondary small">Địa Chỉ / Vị Trí Khuôn Viên</label>
                                <input asp-for="Address" class="form-control" placeholder="VD: Phía Bắc khuôn viên, Cổng số 2" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border: none;">
                                💾 Lưu Tòa Nhà
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
