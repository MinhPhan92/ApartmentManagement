@model IEnumerable<ApartmentManagement.Models.Building>

@{
    ViewData["Title"] = "Quản Lý Tòa Nhà";
}

<div class="container-fluid px-4 py-4">
    <!-- Breadcrumb & Title -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tòa Nhà</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-dark">🏢 Quản Lý Danh Mục Tòa Nhà</h2>
            <p class="text-muted small mb-0">Quản lý cơ cấu các khối tòa nhà và các thông số kỹ thuật hạ tầng.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-3 px-3 shadow-sm d-flex align-items-center gap-2">
                <span>➕</span> <strong>Thêm Tòa Nhà Mới</strong>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
            <span class="fs-5 me-2">✅</span>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
            <span class="fs-5 me-2">⚠️</span>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>
                        <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Tìm theo mã tòa, tên tòa, địa chỉ..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary px-3">Tìm Kiếm</button>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
                    {
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Đặt lại</a>
                    }
                </div>
                <div class="col-auto ms-auto text-muted small">
                    Tổng số: <strong>@Model.Count()</strong> tòa nhà
                </div>
            </form>
        </div>
    </div>

    <!-- Buildings Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Tòa Nhà</th>
                        <th>Tên Tòa Nhà</th>
                        <th>Số Tầng</th>
                        <th>Số Căn Hộ</th>
                        <th>Địa Chỉ</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fw-bold">
                                        @item.BuildingCode
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-dark">@item.BuildingName</strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        🏢 @item.NumberOfFloors tầng
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(item.Apartments.Any() ? "bg-success" : "bg-secondary")">
                                        🚪 @item.Apartments.Count căn
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @(item.Address ?? "Chưa thiết lập")
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.BuildingId" class="btn btn-outline-info" title="Xem chi tiết">
                                            👁️ Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.BuildingId" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            ✏️ Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.BuildingId" class="btn btn-outline-danger" title="Xóa">
                                            🗑️ Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <span class="fs-1 d-block mb-2">🏢</span>
                                <p class="mb-2">Không tìm thấy tòa nhà nào phù hợp.</p>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Thêm tòa nhà đầu tiên</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
