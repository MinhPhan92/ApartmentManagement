@model PaymentTransactionsViewModel
@{
    ViewData["Title"] = "Giao dịch thanh toán";
}
<div class="container py-4">
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div> }
    <h1 class="h3 fw-bold">Giao dịch thanh toán giả lập</h1>
    <p class="text-muted">Không có giao dịch ngân hàng thật. Chỉ xác nhận sau khi đối chiếu ngoài hệ thống.</p>
    @if (Model.Transactions.Count == 0)
    {
        <div class="alert alert-info">Chưa có giao dịch.</div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm">
            <table class="table align-middle mb-0">
                <thead><tr><th>Mã tham chiếu</th><th>Hóa đơn / căn hộ</th><th>Cư dân</th><th class="text-end">Số tiền</th><th>Trạng thái</th><th>Thời điểm</th><th></th></tr></thead>
                <tbody>
                @foreach (var payment in Model.Transactions)
                {
                    <tr>
                        <td>@payment.Reference</td>
                        <td>@payment.Invoice.InvoiceCode<br /><small class="text-muted">@payment.Invoice.Apartment.Building?.BuildingName — @payment.Invoice.Apartment.ApartmentCode</small></td>
                        <td>@payment.Invoice.Resident.User.FullName</td>
                        <td class="text-end">@payment.Amount.ToString("N0") đ</td>
                        <td>@(payment.Status == PaymentTransactionStatus.Pending ? "Chờ xác nhận" : "Đã xác nhận giả lập")</td>
                        <td>@(payment.ConfirmedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                        <td>
                            @if (payment.Status == PaymentTransactionStatus.Pending)
                            {
                                <form asp-action="Confirm" method="post">
                                    <input type="hidden" name="PaymentTransactionId" value="@payment.PaymentTransactionId" />
                                    <input type="hidden" name="RowVersionToken" value="@Convert.ToBase64String(payment.RowVersion)" />
                                    <button type="submit" class="btn btn-sm btn-success">Xác nhận mô phỏng</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
