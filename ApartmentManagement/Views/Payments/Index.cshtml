@model PaymentTransactionsViewModel
@{
    ViewData["Title"] = "Quản lý giao dịch thanh toán";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Giao dịch thanh toán</h1>
            <p class="text-muted mb-0">Theo dõi, đối chiếu và xác nhận các giao dịch thanh toán phí chung cư.</p>
        </div>
        <a asp-controller="Billing" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-receipt"></i> Về trang Hóa đơn
        </a>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="status">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Tổng giao dịch</span>
                            <h3 class="fw-bold mt-2 mb-1">@Model.TotalCount</h3>
                            <span class="small text-muted">Bản ghi giao dịch hệ thống</span>
                        </div>
                        <div class="p-3 bg-secondary-subtle text-secondary rounded-4">
                            <i class="bi bi-credit-card-2-back fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Chờ xác nhận</span>
                            <h3 class="fw-bold mt-2 mb-1 text-warning">@Model.PendingCount</h3>
                            <span class="small text-warning fw-medium">Cần kiểm tra đối soát</span>
                        </div>
                        <div class="p-3 bg-warning-subtle text-warning rounded-4">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Đã xác nhận</span>
                            <h3 class="fw-bold mt-2 mb-1 text-success">@Model.ConfirmedCount</h3>
                            <span class="small text-success fw-medium">Đã ghi nhận thanh toán</span>
                        </div>
                        <div class="p-3 bg-success-subtle text-success rounded-4">
                            <i class="bi bi-check2-all fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Tổng tiền đã thu</span>
                            <h3 class="fw-bold mt-2 mb-1 text-primary">@Model.TotalConfirmedAmount.ToString("N0") <small class="fs-6 text-muted">đ</small></h3>
                            <span class="small text-muted">Từ các giao dịch xác nhận</span>
                        </div>
                        <div class="p-3 bg-primary-subtle text-primary rounded-4">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-lg-3">
                    <label for="status" class="form-label small fw-semibold text-muted">Trạng thái giao dịch</label>
                    <select id="status" name="status" asp-items="Model.StatusOptions" class="form-select"></select>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    <label for="searchTerm" class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                    <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Mã tham chiếu, mã HĐ, căn hộ, cư dân" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-funnel-fill"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Notice Banner -->
    <div class="alert alert-info border-0 rounded-4 d-flex gap-3 align-items-center mb-4">
        <i class="bi bi-info-circle-fill fs-4 text-info flex-shrink-0"></i>
        <div class="small">
            Hệ thống đang hoạt động theo cơ chế thanh toán mô phỏng (Simulated Offline/VietQR). Việc quét mã QR không tự động ghi nhận tiền về tài khoản ngân hàng; nhân viên kế toán cần kiểm tra sao kê độc lập rồi mới bấm <strong>Xác nhận</strong>.
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h2 class="h5 fw-bold mb-0">Danh sách giao dịch</h2>
            <span class="badge bg-light text-muted border">@Model.Transactions.Count kết quả</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã tham chiếu</th>
                        <th>Hóa đơn & Căn hộ</th>
                        <th>Cư dân</th>
                        <th class="text-end">Số tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Thời điểm</th>
                        <th>Người xác nhận</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Transactions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <span>Không có giao dịch nào phù hợp.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var payment in Model.Transactions)
                    {
                        var rowVersionToken = Convert.ToBase64String(payment.RowVersion);
                        var modalId = $"confirmModal_{payment.PaymentTransactionId}";

                        <tr>
                            <td class="ps-4 font-monospace fw-semibold text-primary">@payment.Reference</td>
                            <td>
                                <a asp-controller="Billing" asp-action="Details" asp-route-id="@payment.ApartmentInvoiceId" class="text-decoration-none fw-semibold">
                                    @payment.Invoice.InvoiceCode
                                </a>
                                <small class="text-muted d-block">
                                    @(payment.Invoice.Apartment.Building?.BuildingName ?? "Chung cư") — @payment.Invoice.Apartment.ApartmentCode
                                </small>
                            </td>
                            <td>@payment.Invoice.Resident.User.FullName</td>
                            <td class="text-end fw-bold text-success">@payment.Amount.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (payment.Status == PaymentTransactionStatus.Pending)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ xác nhận</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đã xác nhận</span>
                                }
                            </td>
                            <td>
                                @if (payment.Status == PaymentTransactionStatus.Confirmed && payment.ConfirmedAtUtc.HasValue)
                                {
                                    <div>@payment.ConfirmedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    <small class="text-muted">Tạo: @payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                }
                                else
                                {
                                    <div>@payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                }
                            </td>
                            <td>@(payment.ConfirmedByUser?.FullName ?? "—")</td>
                            <td class="text-end pe-4">
                                @if (payment.Status == PaymentTransactionStatus.Pending)
                                {
                                    <button type="button" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#@modalId">
                                        <i class="bi bi-check-lg"></i> Xác nhận
                                    </button>

                                    <!-- Confirm Payment Modal -->
                                    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@(modalId)_Label" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold" id="@(modalId)_Label">Xác nhận giao dịch thanh toán</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Confirm" method="post">
                                                    <div class="modal-body py-4">
                                                        <p class="mb-2">Bạn có chắc chắn muốn xác nhận đã thu đủ tiền cho giao dịch:</p>
                                                        <div class="p-3 bg-light rounded-3 mb-3">
                                                            <div class="row g-2 small">
                                                                <div class="col-5 text-muted">Mã tham chiếu:</div>
                                                                <div class="col-7 font-monospace fw-bold text-primary">@payment.Reference</div>
                                                                <div class="col-5 text-muted">Số tiền:</div>
                                                                <div class="col-7 fw-bold text-success fs-6">@payment.Amount.ToString("N0") đ</div>
                                                                <div class="col-5 text-muted">Căn hộ:</div>
                                                                <div class="col-7">@payment.Invoice.Apartment.ApartmentCode</div>
                                                                <div class="col-5 text-muted">Cư dân:</div>
                                                                <div class="col-7">@payment.Invoice.Resident.User.FullName</div>
                                                            </div>
                                                        </div>
                                                        <p class="text-muted small mb-0">Thao tác này sẽ cập nhật trạng thái thanh toán và số dư công nợ của hóa đơn tương ứng.</p>
                                                        <input type="hidden" name="PaymentTransactionId" value="@payment.PaymentTransactionId" />
                                                        <input type="hidden" name="RowVersionToken" value="@rowVersionToken" />
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-success">Xác nhận thanh toán</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-check2 text-success"></i> Hoàn tất</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
