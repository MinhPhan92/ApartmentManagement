@model ApartmentManagement.Models.Resident

@{
    ViewData["Title"] = "Không Gian Cư Dân";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Resident profile header -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 fs-2">
                                🏠
                            </div>
                            <div>
                                <h3 class="fw-bold mb-1">Xin chào, @ViewBag.UserFullName!</h3>
                                <p class="mb-0 text-white-50">Cổng thông tin cư dân căn hộ · Email: @ViewBag.UserEmail</p>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-success bg-opacity-75 px-3 py-2 fs-6">Đã Kích Hoạt Cư Dân</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Personal Details -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Thông Tin Cá Nhân</h5>
                    <a asp-action="EditProfile" class="btn btn-sm btn-outline-primary fw-semibold">
                        ✏️ Chỉnh sửa
                    </a>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Số CCCD / CMND:</span>
                                <span class="fw-semibold">@Model.CitizenId</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Ngày sinh:</span>
                                <span class="fw-semibold">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Giới tính:</span>
                                <span class="fw-semibold">@(Model.Gender ?? "Chưa rõ")</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Liên hệ khẩn cấp:</span>
                                <span class="fw-semibold">@(Model.EmergencyContact ?? "Chưa rõ")</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Địa chỉ thường trú:</span>
                                <span class="fw-semibold">@(Model.Address ?? "Chưa rõ")</span>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Hồ sơ cư dân chưa được thiết lập. Vui lòng liên hệ ban quản lý.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Active Apartment & Household Members -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">👥 Căn Hộ & Thành Viên Hộ Gia Đình</h5>
                    @if (ViewBag.ActiveApartment != null)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                            @ViewBag.ActiveApartment.ApartmentCode (@ViewBag.ActiveApartment.Building?.BuildingName)
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (ViewBag.ActiveApartment != null)
                    {
                        <div class="p-3 bg-light rounded-3 mb-3">
                            <div class="row g-2 small text-muted">
                                <div class="col-6 col-sm-3">Mã phòng: <strong class="text-dark">@ViewBag.ActiveApartment.ApartmentCode</strong></div>
                                <div class="col-6 col-sm-3">Tầng: <strong class="text-dark">@ViewBag.ActiveApartment.Floor</strong></div>
                                <div class="col-6 col-sm-3">Diện tích: <strong class="text-dark">@ViewBag.ActiveApartment.Area m²</strong></div>
                                <div class="col-6 col-sm-3">Trạng thái: <strong class="text-success">@ViewBag.ActiveApartment.Status</strong></div>
                            </div>
                        </div>

                        var members = (List<ApartmentManagement.Models.ApartmentResident>?)ViewBag.HouseholdMembers;
                        if (members != null && members.Any())
                        {
                            <h6 class="fw-bold text-muted small mb-2">DANH SÁCH THÀNH VIÊN ĐÃ ĐƯỢC XÁC NHẬN</h6>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Thành viên</th>
                                            <th>Quan hệ</th>
                                            <th>Ngày vào ở</th>
                                            <th class="text-end">Vai trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in members)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    @(m.Resident?.User?.FullName ?? "N/A")
                                                    @if (m.Resident?.UserId == Model?.UserId)
                                                    {
                                                        <span class="badge bg-info-subtle text-info ms-1">Bạn</span>
                                                    }
                                                </td>
                                                <td>@m.Relationship</td>
                                                <td>@m.MoveInDate.ToString("dd/MM/yyyy")</td>
                                                <td class="text-end">
                                                    @if (m.IsOwner)
                                                    {
                                                        <span class="badge bg-primary">Chủ Hộ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark border">Thành viên</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <span class="fs-1 d-block mb-2">🔑</span>
                            <p class="mb-0">Bạn hiện chưa được liên kết với căn hộ nào đang hoạt động. Vui lòng liên hệ Ban Quản Lý.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Occupancy History -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">📜 Lịch Sử Cư Trú</h5>
                </div>
                <div class="card-body">
                    @if (Model?.ApartmentResidents != null && Model.ApartmentResidents.Any())
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var ar in Model.ApartmentResidents)
                            {
                                <div class="col">
                                    <div class="border rounded-3 p-3 h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold mb-0 text-primary">Căn hộ @ar.Apartment?.ApartmentCode - Tòa @ar.Apartment?.Building?.BuildingName</h6>
                                            <span class="badge @(ar.MoveOutDate == null ? "bg-success" : "bg-secondary")">
                                                @(ar.MoveOutDate == null ? "Đang cư trú" : "Đã chuyển đi")
                                            </span>
                                        </div>
                                        <div class="row g-2 text-muted small">
                                            <div class="col-6">Tầng: <strong class="text-dark">@ar.Apartment?.Floor</strong></div>
                                            <div class="col-6">Diện tích: <strong class="text-dark">@ar.Apartment?.Area m²</strong></div>
                                            <div class="col-6">Ngày vào ở: <strong class="text-dark">@ar.MoveInDate.ToString("dd/MM/yyyy")</strong></div>
                                            <div class="col-6">Quan hệ: <strong class="text-dark">@ar.Relationship</strong></div>
                                            <div class="col-6">Ngày chuyển đi: <strong class="text-dark">@(ar.MoveOutDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</strong></div>
                                            <div class="col-6">Vai trò: <strong class="text-dark">@(ar.IsOwner ? "Chủ hộ" : "Thành viên")</strong></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <p class="mb-0">Chưa có lịch sử cư trú.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Resident Services -->
        <div class="col-12 mt-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Dịch Vụ Cư Dân Nhanh</h5>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                <div class="col">
                    <a asp-controller="Vehicle" asp-action="Index" class="card card-body text-center shadow-sm border-0 text-decoration-none h-100 hover-card p-3">
                        <span class="fs-2 mb-1">🚗</span>
                        <span class="fw-semibold text-dark small">Phương tiện</span>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Complaint" asp-action="Index" class="card card-body text-center shadow-sm border-0 text-decoration-none h-100 hover-card p-3">
                        <span class="fs-2 mb-1">📢</span>
                        <span class="fw-semibold text-dark small">Phản ánh</span>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="MyAmenities" asp-action="Index" class="card card-body text-center shadow-sm border-0 text-decoration-none h-100 hover-card p-3">
                        <span class="fs-2 mb-1">🏊</span>
                        <span class="fw-semibold text-dark small">Đặt tiện ích</span>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Visitors" asp-action="Index" class="card card-body text-center shadow-sm border-0 text-decoration-none h-100 hover-card p-3">
                        <span class="fs-2 mb-1">🚶</span>
                        <span class="fw-semibold text-dark small">Đăng ký khách</span>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="MyInvoices" asp-action="Index" class="card card-body text-center shadow-sm border-0 text-decoration-none h-100 hover-card p-3">
                        <span class="fs-2 mb-1">🧾</span>
                        <span class="fw-semibold text-dark small">Hóa đơn</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
