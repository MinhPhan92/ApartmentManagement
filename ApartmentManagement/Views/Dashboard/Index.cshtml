@model IEnumerable<ApartmentManagement.Models.Building>

@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Lý";
    var occupiedCount = (int)(ViewBag.OccupiedApartments ?? 0);
    var totalApartments = (int)(ViewBag.TotalApartments ?? 0);
    var occupancyRate = totalApartments > 0 ? (occupiedCount * 100.0 / totalApartments) : 0.0;
}

<div class="d-flex flex-column gap-4">
    <!-- Header Greeting & Quick Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-bold text-dark mb-0">Bảng Điều Khiển Quản Trị</h3>
                <span class="badge-brand">@ViewBag.UserRole</span>
            </div>
            <p class="text-muted mb-0 small">
                Chào mừng trở lại, <span class="fw-semibold text-dark">@ViewBag.UserFullName</span> · Hệ thống giám sát vận hành thời gian thực
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-controller="Buildings" asp-action="Create" class="btn btn-brand-primary">
                <i class="bi bi-plus-lg"></i>
                <span>Thêm Tòa Nhà</span>
            </a>
            <a asp-controller="Apartments" asp-action="Index" class="btn btn-brand-outline">
                <i class="bi bi-door-open"></i>
                <span>Quản Lý Căn Hộ</span>
            </a>
            <a asp-controller="Occupancies" asp-action="Create" class="btn btn-brand-ghost">
                <i class="bi bi-person-plus"></i>
                <span>Gán Cư Dân</span>
            </a>
        </div>
    </div>

    <!-- 1. Primary Metrics Overview Grid (4 Columns) -->
    <div class="row g-3">
        <!-- Metric 1: Total Buildings -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="metric-label">Tổng Tòa Nhà</div>
                        <div class="metric-value">@ViewBag.TotalBuildings</div>
                    </div>
                    <div class="metric-icon-box">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
                <div class="metric-subtext d-flex align-items-center gap-1">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span>Đang quản lý trong hệ thống</span>
                </div>
            </div>
        </div>

        <!-- Metric 2: Total Apartments -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="metric-label">Tổng Căn Hộ</div>
                        <div class="metric-value">@ViewBag.TotalApartments</div>
                    </div>
                    <div class="metric-icon-box success">
                        <i class="bi bi-door-open"></i>
                    </div>
                </div>
                <div class="metric-subtext">
                    <span class="text-success fw-semibold">@ViewBag.OccupiedApartments có người ở</span> ·
                    <span class="text-muted">@ViewBag.VacantApartments còn trống</span>
                </div>
            </div>
        </div>

        <!-- Metric 3: Total Residents -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="metric-label">Cư Dân Đăng Ký</div>
                        <div class="metric-value">@ViewBag.TotalResidents</div>
                    </div>
                    <div class="metric-icon-box info">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="metric-subtext">
                    <span>Hồ sơ định danh & cư trú chính thức</span>
                </div>
            </div>
        </div>

        <!-- Metric 4: Occupancy Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="metric-label">Tỷ Lệ Lấp Đầy</div>
                        <div class="metric-value">@occupancyRate.ToString("0.0")%</div>
                    </div>
                    <div class="metric-icon-box">
                        <i class="bi bi-pie-chart"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height: 6px; background-color: var(--primary-tint);">
                        <div class="progress-bar" role="progressbar" style="width: @occupancyRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%; background-color: var(--primary);" aria-valuenow="@occupancyRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span class="small fw-semibold text-muted">Ổn định</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Operational Priority / Action Alerts (4 Columns) -->
    <div>
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="fw-bold text-uppercase text-muted small mb-0">Hạng Mục Cần Theo Dõi & Phê Duyệt</h6>
            <span class="badge bg-white text-muted border small">Cập nhật tức thời</span>
        </div>
        <div class="row g-3">
            <!-- Alert 1: Pending Incidents -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="alert-action-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small text-muted">Sự Cố Kỹ Thuật</span>
                        <div class="metric-icon-box danger" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-tools"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <h4 class="fw-bold mb-0 text-danger">@ViewBag.PendingTickets</h4>
                        <span class="small text-muted">yêu cầu đang mở</span>
                    </div>
                    <a asp-controller="RepairQueue" asp-action="Index" class="action-link">
                        <span>Hàng đợi kỹ thuật</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Alert 2: Pending Complaints -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="alert-action-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small text-muted">Ý Kiến & Phản Ánh</span>
                        <div class="metric-icon-box warning" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <h4 class="fw-bold mb-0 text-warning">@ViewBag.PendingComplaints</h4>
                        <span class="small text-muted">cần giải quyết</span>
                    </div>
                    <a asp-controller="Complaint" asp-action="Index" class="action-link">
                        <span>Xử lý phản ánh</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Alert 3: Pending Vehicles -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="alert-action-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small text-muted">Đăng Ký Xe Chờ Duyệt</span>
                        <div class="metric-icon-box info" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-car-front"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <h4 class="fw-bold mb-0 text-primary">@ViewBag.PendingVehicles</h4>
                        <span class="small text-muted">hồ sơ gửi duyệt</span>
                    </div>
                    <a asp-controller="Vehicle" asp-action="Index" asp-route-status="Chờ duyệt" class="action-link">
                        <span>Duyệt phương tiện</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Alert 4: Unpaid Invoices -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="alert-action-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small text-muted">Hóa Đơn Kỳ Này</span>
                        <div class="metric-icon-box success" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <h4 class="fw-bold mb-0 text-success">@ViewBag.UnpaidInvoices</h4>
                        <span class="small text-muted">chưa thanh toán</span>
                    </div>
                    <a asp-controller="Billing" asp-action="Index" class="action-link">
                        <span>Quản lý thu phí</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Main Data Content: Buildings Table (Left 8 cols) & Implementation Stepper (Right 4 cols) -->
    <div class="row g-4">
        <!-- Left Table: Buildings -->
        <div class="col-12 col-lg-8">
            <div class="card-enterprise h-100">
                <div class="card-enterprise-header">
                    <div>
                        <h5 class="fw-bold mb-1">Danh Sách Tòa Nhà Trực Thuộc</h5>
                        <p class="text-muted small mb-0">Quản lý phân khu, tầng cao và danh mục căn hộ</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Buildings" asp-action="Index" class="btn btn-brand-ghost btn-sm">
                            <span>Xem toàn bộ</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table-enterprise">
                            <thead>
                                <tr>
                                    <th>Mã Tòa</th>
                                    <th>Tên Tòa Nhà</th>
                                    <th>Số Tầng</th>
                                    <th>Quy Mô</th>
                                    <th>Địa Chỉ</th>
                                    <th class="text-end pe-4">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var building in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge-brand">@building.BuildingCode</span>
                                            </td>
                                            <td class="fw-semibold text-dark">
                                                @building.BuildingName
                                            </td>
                                            <td>
                                                <span class="text-muted">@building.NumberOfFloors tầng</span>
                                            </td>
                                            <td>
                                                <span class="fw-medium text-dark">@building.Apartments.Count</span>
                                                <span class="text-muted small">căn hộ</span>
                                            </td>
                                            <td class="text-muted small text-truncate" style="max-width: 200px;">
                                                @(building.Address ?? "Chưa cập nhật")
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="Buildings" asp-action="Details" asp-route-id="@building.BuildingId" class="btn btn-brand-ghost text-primary" title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i> Chi tiết
                                                    </a>
                                                    <a asp-controller="Buildings" asp-action="Edit" asp-route-id="@building.BuildingId" class="btn btn-brand-ghost text-muted" title="Chỉnh sửa">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="bi bi-building-slash fs-1 d-block mb-2 text-muted"></i>
                                            <p class="mb-2">Chưa có tòa nhà nào được khởi tạo trong hệ thống.</p>
                                            <a asp-controller="Buildings" asp-action="Create" class="btn btn-brand-primary btn-sm">
                                                <i class="bi bi-plus-lg"></i> Khởi tạo tòa nhà đầu tiên
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Implementation Stepper & Quick Shortcuts -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <!-- Stepper / Milestone Tracker -->
            <div class="card-enterprise">
                <div class="card-enterprise-header">
                    <div>
                        <h6 class="fw-bold mb-0">Lộ Trình Triển Khai Hệ Thống</h6>
                        <span class="text-muted small">Tiến độ chuẩn hóa nghiệp vụ</span>
                    </div>
                    <span class="badge-subtle-success">Hoạt động tốt</span>
                </div>
                <div class="card-enterprise-body">
                    <ul class="stepper-timeline">
                        <!-- Step 1 -->
                        <li class="step-item completed">
                            <div class="step-marker">
                                <i class="bi bi-check" style="font-size: 0.75rem;"></i>
                            </div>
                            <div class="step-title">1. Tòa Nhà & Cấu Trúc Khối</div>
                            <div class="step-desc">Hoàn thiện CRUD tòa nhà, tầng và mã khối</div>
                        </li>

                        <!-- Step 2 -->
                        <li class="step-item completed">
                            <div class="step-marker">
                                <i class="bi bi-check" style="font-size: 0.75rem;"></i>
                            </div>
                            <div class="step-title">2. Quản Lý Căn Hộ & Diện Tích</div>
                            <div class="step-desc">Trạng thái trống, đang ở, bảo trì</div>
                        </li>

                        <!-- Step 3 -->
                        <li class="step-item completed">
                            <div class="step-marker">
                                <i class="bi bi-check" style="font-size: 0.75rem;"></i>
                            </div>
                            <div class="step-title">3. Cư Dân & Ràng Buộc Chủ Hộ</div>
                            <div class="step-desc">Đã nghiệm thu (UX_ActiveOwner, Hộ gia đình)</div>
                        </li>

                        <!-- Step 4 -->
                        <li class="step-item active">
                            <div class="step-marker"></div>
                            <div class="step-title text-primary">4. Vận Hành & Kỹ Thuật</div>
                            <div class="step-desc">Sự cố, Khiếu nại, Tiện ích, Bảng tin, Khách</div>
                        </li>

                        <!-- Step 5 -->
                        <li class="step-item">
                            <div class="step-marker"></div>
                            <div class="step-title text-muted">5. Tài Chính & Hóa Đơn Tự Động</div>
                            <div class="step-desc">Biểu phí, Chỉ số đồng hồ, VietQR & Giao dịch</div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Quick Operational Shortcuts -->
            <div class="card-enterprise">
                <div class="card-enterprise-header">
                    <h6 class="fw-bold mb-0">Thao Tác Nhanh</h6>
                    <i class="bi bi-lightning-charge text-warning"></i>
                </div>
                <div class="card-enterprise-body d-flex flex-column gap-2 p-3">
                    <a asp-controller="Occupancies" asp-action="Create" class="btn btn-brand-ghost justify-content-start text-start w-100 p-2">
                        <i class="bi bi-person-plus text-primary fs-5 me-2"></i>
                        <div>
                            <div class="fw-semibold text-dark small">Gán Cư Dân Vào Căn Hộ</div>
                            <span class="text-muted" style="font-size: 0.72rem;">Thủ tục chuyển vào (Move-In)</span>
                        </div>
                    </a>
                    <a asp-controller="Contracts" asp-action="Create" class="btn btn-brand-ghost justify-content-start text-start w-100 p-2">
                        <i class="bi bi-file-earmark-plus text-primary fs-5 me-2"></i>
                        <div>
                            <div class="fw-semibold text-dark small">Lập Hợp Đồng Thuê Mới</div>
                            <span class="text-muted" style="font-size: 0.72rem;">Khởi tạo hợp đồng lưu trú</span>
                        </div>
                    </a>
                    <a asp-controller="Billing" asp-action="Index" class="btn btn-brand-ghost justify-content-start text-start w-100 p-2">
                        <i class="bi bi-speedometer text-primary fs-5 me-2"></i>
                        <div>
                            <div class="fw-semibold text-dark small">Ghi Chỉ Số & Lập Hóa Đơn</div>
                            <span class="text-muted" style="font-size: 0.72rem;">Điện, nước, dịch vụ định kỳ</span>
                        </div>
                    </a>
                    <a asp-controller="Announcements" asp-action="Create" class="btn btn-brand-ghost justify-content-start text-start w-100 p-2">
                        <i class="bi bi-megaphone text-primary fs-5 me-2"></i>
                        <div>
                            <div class="fw-semibold text-dark small">Đăng Thông Báo Toàn Khu</div>
                            <span class="text-muted" style="font-size: 0.72rem;">Gửi bản tin đến cư dân</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
