@model IEnumerable<ApartmentManagement.Models.Building>

@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<div class="container-fluid py-3">
    <!-- Header banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">🏢 Bảng Điều Khiển Quản Lý</h2>
            <p class="text-muted mb-0">Xin chào, <span class="fw-semibold text-primary">@ViewBag.UserFullName</span> | Vai trò: <span class="badge bg-primary">@ViewBag.UserRole</span></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Buildings" asp-action="GetBuildings" class="btn btn-outline-primary btn-sm">
                📋 Danh Sách Tòa Nhà (API)
            </a>
            <a asp-controller="Apartments" asp-action="GetApartments" class="btn btn-outline-secondary btn-sm">
                🚪 Danh Sách Căn Hộ (API)
            </a>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-primary fw-semibold small">TỔNG TÒA NHÀ</span>
                        <span class="fs-4">🏢</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalBuildings</h3>
                    <small class="text-muted">Đang quản lý</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-success fw-semibold small">TỔNG CĂN HỘ</span>
                        <span class="fs-4">🚪</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalApartments</h3>
                    <small class="text-success">@ViewBag.OccupiedApartments có người ở · @ViewBag.VacantApartments còn trống</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-warning fw-semibold small">CƯ DÂN</span>
                        <span class="fs-4">👥</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalResidents</h3>
                    <small class="text-muted">Đã đăng ký hồ sơ</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-purple fw-semibold small" style="color: #7e22ce;">TỶ LỆ LẤP ĐẦY</span>
                        <span class="fs-4">📈</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">
                        @if (ViewBag.TotalApartments > 0)
                        {
                            @((ViewBag.OccupiedApartments * 100 / (double)ViewBag.TotalApartments).ToString("0.0"))<span>%</span>
                        }
                        else
                        {
                            <span>0%</span>
                        }
                    </h3>
                    <small class="text-muted">Trạng thái vận hành ổn định</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick action & building list -->
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Danh Sách Tòa Nhà Trực Thuộc</h5>
                    <span class="badge bg-light text-dark border">Top mới nhất</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Tòa</th>
                                    <th>Tên Tòa Nhà</th>
                                    <th>Số Tầng</th>
                                    <th>Số Căn Hộ</th>
                                    <th>Địa Chỉ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var building in Model)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@building.BuildingCode</span></td>
                                            <td class="fw-semibold">@building.BuildingName</td>
                                            <td>@building.NumberOfFloors tầng</td>
                                            <td>@building.Apartments.Count căn</td>
                                            <td class="text-muted small">@(building.Address ?? "Chưa cập nhật")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            Chưa có dữ liệu tòa nhà. Hãy thêm tòa nhà đầu tiên ở module Building.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">Lộ Trình Triển Khai Nghiệp Vụ</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>1. Tòa Nhà (Building)</span>
                            <span class="badge bg-success">Đã hoàn thành DB</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>2. Căn Hộ (Apartment)</span>
                            <span class="badge bg-success">Đã hoàn thành DB</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>3. Cư Dân (Resident)</span>
                            <span class="badge bg-success">Đã hoàn thành DB</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>4. Phân Bổ (ApartmentResident)</span>
                            <span class="badge bg-success">Đã hoàn thành DB</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                            <span>5. Phương Tiện & Dịch Vụ</span>
                            <span class="badge bg-light text-muted">Giai đoạn kế tiếp</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
