<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApartmentHub Enterprise</title>

    <!-- Typography: Google Fonts Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Enterprise Design System Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApartmentManagement.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        <div class="app-wrapper">
            <!-- Mobile Backdrop -->
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <!-- Left Sidebar Navigation -->
            <aside class="app-sidebar" id="appSidebar">
                <!-- Sidebar Header / Logo -->
                <div class="sidebar-header">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-3 text-decoration-none">
                        <div class="brand-emblem">
                            <i class="bi bi-buildings"></i>
                        </div>
                        <div>
                            <div class="brand-title">ApartmentHub</div>
                            <div class="brand-subtitle">Quản Lý Chung Cư</div>
                        </div>
                    </a>
                </div>

                <!-- Navigation Groups -->
                <div class="sidebar-body">
                    <!-- SECTION 1: TỔNG QUAN -->
                    <div class="nav-section-title">Tổng quan</div>
                    <ul class="sidebar-nav">
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager") || User.IsInRole("Technician") || User.IsInRole("Accountant"))
                        {
                            <li class="sidebar-nav-item">
                                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-nav-link @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")">
                                    <i class="bi bi-grid-1x2-fill"></i>
                                    <span>Bảng điều khiển</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Resident"))
                        {
                            <li class="sidebar-nav-item">
                                <a asp-controller="Dashboard" asp-action="Resident" class="sidebar-nav-link @(currentController == "Dashboard" && currentAction == "Resident" ? "active" : "")">
                                    <i class="bi bi-person-workspace"></i>
                                    <span>Cổng Cư Dân</span>
                                </a>
                            </li>
                        }
                        <li class="sidebar-nav-item">
                            <a asp-controller="Home" asp-action="Index" class="sidebar-nav-link @(currentController == "Home" ? "active" : "")">
                                <i class="bi bi-house"></i>
                                <span>Trang chủ</span>
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager"))
                    {
                        <!-- SECTION 2: CĂN HỘ & CƯ DÂN -->
                        <div class="nav-section-title">Căn hộ & Cư dân</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a asp-controller="Buildings" asp-action="Index" class="sidebar-nav-link @(currentController == "Buildings" ? "active" : "")">
                                    <i class="bi bi-building"></i>
                                    <span>Tòa nhà</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Apartments" asp-action="Index" class="sidebar-nav-link @(currentController == "Apartments" ? "active" : "")">
                                    <i class="bi bi-door-open"></i>
                                    <span>Căn hộ</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Residents" asp-action="Index" class="sidebar-nav-link @(currentController == "Residents" ? "active" : "")">
                                    <i class="bi bi-people"></i>
                                    <span>Cư dân</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Occupancies" asp-action="Index" class="sidebar-nav-link @(currentController == "Occupancies" ? "active" : "")">
                                    <i class="bi bi-person-badge"></i>
                                    <span>Lưu trú & Hộ gia đình</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Contracts" asp-action="Index" class="sidebar-nav-link @(currentController == "Contracts" ? "active" : "")">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <span>Hợp đồng</span>
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("Resident"))
                    {
                        <!-- RESIDENT SPECIFIC SERVICES -->
                        <div class="nav-section-title">Dịch vụ cư dân</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a asp-controller="MyContracts" asp-action="Index" class="sidebar-nav-link @(currentController == "MyContracts" ? "active" : "")">
                                    <i class="bi bi-file-earmark-check"></i>
                                    <span>Hợp đồng của tôi</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="MyInvoices" asp-action="Index" class="sidebar-nav-link @(currentController == "MyInvoices" ? "active" : "")">
                                    <i class="bi bi-receipt"></i>
                                    <span>Hóa đơn của tôi</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="MyIncidents" asp-action="Index" class="sidebar-nav-link @(currentController == "MyIncidents" ? "active" : "")">
                                    <i class="bi bi-tools"></i>
                                    <span>Báo sự cố</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="MyAmenities" asp-action="Index" class="sidebar-nav-link @(currentController == "MyAmenities" ? "active" : "")">
                                    <i class="bi bi-calendar2-check"></i>
                                    <span>Đặt tiện ích</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Vehicle" asp-action="Index" class="sidebar-nav-link @(currentController == "Vehicle" ? "active" : "")">
                                    <i class="bi bi-car-front"></i>
                                    <span>Phương tiện</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Complaint" asp-action="Index" class="sidebar-nav-link @(currentController == "Complaint" ? "active" : "")">
                                    <i class="bi bi-chat-left-dots"></i>
                                    <span>Phản ánh kiến nghị</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Visitors" asp-action="Index" class="sidebar-nav-link @(currentController == "Visitors" ? "active" : "")">
                                    <i class="bi bi-person-check"></i>
                                    <span>Đăng ký khách</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Announcements" asp-action="Index" class="sidebar-nav-link @(currentController == "Announcements" ? "active" : "")">
                                    <i class="bi bi-megaphone"></i>
                                    <span>Bảng tin chung cư</span>
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager") || User.IsInRole("Technician"))
                    {
                        <!-- SECTION 3: VẬN HÀNH & KỸ THUẬT -->
                        <div class="nav-section-title">Vận hành & Kỹ thuật</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a asp-controller="IncidentQueue" asp-action="Index" class="sidebar-nav-link @(currentController == "IncidentQueue" ? "active" : "")">
                                    <i class="bi bi-tools"></i>
                                    <span>Hàng đợi sự cố</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Complaint" asp-action="Index" class="sidebar-nav-link @(currentController == "Complaint" ? "active" : "")">
                                    <i class="bi bi-chat-left-dots"></i>
                                    <span>Tiếp nhận khiếu nại</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Amenities" asp-action="Index" class="sidebar-nav-link @(currentController == "Amenities" ? "active" : "")">
                                    <i class="bi bi-calendar2-week"></i>
                                    <span>Quản lý tiện ích</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Announcements" asp-action="Index" class="sidebar-nav-link @(currentController == "Announcements" ? "active" : "")">
                                    <i class="bi bi-megaphone"></i>
                                    <span>Bảng tin thông báo</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Visitors" asp-action="Index" class="sidebar-nav-link @(currentController == "Visitors" ? "active" : "")">
                                    <i class="bi bi-person-check"></i>
                                    <span>Khách viếng thăm</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Vehicle" asp-action="Index" class="sidebar-nav-link @(currentController == "Vehicle" ? "active" : "")">
                                    <i class="bi bi-car-front"></i>
                                    <span>Duyệt phương tiện</span>
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager") || User.IsInRole("Accountant"))
                    {
                        <!-- SECTION 4: TÀI CHÍNH & HÓA ĐƠN -->
                        <div class="nav-section-title">Tài chính & Hóa đơn</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a asp-controller="Billing" asp-action="Index" class="sidebar-nav-link @(currentController == "Billing" ? "active" : "")">
                                    <i class="bi bi-receipt"></i>
                                    <span>Phí & Hóa đơn</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <a asp-controller="Payments" asp-action="Index" class="sidebar-nav-link @(currentController == "Payments" ? "active" : "")">
                                    <i class="bi bi-credit-card"></i>
                                    <span>Lịch sử giao dịch</span>
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <!-- SECTION 5: HỆ THỐNG -->
                        <div class="nav-section-title">Hệ thống</div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-nav-item">
                                <a asp-controller="Accounts" asp-action="Index" class="sidebar-nav-link @(currentController == "Accounts" ? "active" : "")">
                                    <i class="bi bi-shield-lock"></i>
                                    <span>Quản lý tài khoản</span>
                                </a>
                            </li>
                        </ul>
                    }
                </div>

                <!-- Sidebar Footer Status -->
                <div class="sidebar-footer d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                        <span class="small text-muted fw-semibold">Hệ thống sẵn sàng</span>
                    </div>
                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">v2.6</span>
                </div>
            </aside>

            <!-- Main Panel Container -->
            <div class="app-main">
                <!-- Top Header Bar -->
                <header class="app-header">
                    <div class="d-flex align-items-center gap-3">
                        <!-- Mobile Hamburger Button -->
                        <button class="btn btn-icon-header d-lg-none" type="button" id="sidebarToggleBtn" aria-label="Toggle Navigation">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <!-- Context Breadcrumb or Brand Header -->
                        <div class="d-none d-sm-flex align-items-center gap-2 text-muted small">
                            <span class="fw-semibold text-dark">ApartmentHub</span>
                            <i class="bi bi-chevron-right text-muted" style="font-size: 0.75rem;"></i>
                            <span>@(ViewData["Title"] ?? "Quản Trị")</span>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="header-search position-relative" id="globalSearchContainer">
                        <i class="bi bi-search"></i>
                        <input type="text" id="globalSearchInput" placeholder="Tìm kiếm căn hộ, cư dân, hợp đồng..." aria-label="Tìm kiếm nhanh" autocomplete="off" spellcheck="false">
                        <div class="search-spinner d-none" id="globalSearchSpinner">
                            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                        </div>
                        <div class="search-dropdown-menu d-none" id="globalSearchDropdown" role="listbox" aria-label="Kết quả tìm kiếm"></div>
                    </div>

                    <!-- Topbar Actions & User Menu -->
                    <div class="header-actions">
                        <!-- Notifications -->
                        <button class="btn btn-icon-header" type="button" title="Thông báo hệ thống">
                            <i class="bi bi-bell"></i>
                            <span class="notification-badge"></span>
                        </button>

                        <!-- User Profile Dropdown -->
                        <partial name="_LoginPartial" />
                    </div>
                </header>

                <!-- Page Content Body -->
                <main role="main" class="app-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <!-- Modern Footer -->
                <footer class="app-footer">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                        <span>&copy; 2026 <strong>ApartmentHub</strong> · Hệ thống quản lý vận hành chung cư chuyên nghiệp</span>
                        <div class="d-flex gap-3">
                            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
                            <span class="text-muted">·</span>
                            <span class="text-muted">Trung tâm hỗ trợ BQL</span>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout for Non-Authenticated Users -->
        <header class="sticky-top bg-white border-bottom shadow-sm">
            <nav class="navbar navbar-expand-lg navbar-light py-3">
                <div class="container px-4">
                    <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <div class="brand-emblem">
                            <i class="bi bi-buildings"></i>
                        </div>
                        <span class="brand-title">ApartmentHub</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="publicNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                            <li class="nav-item">
                                <a class="nav-link text-secondary" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-secondary" asp-controller="Announcements" asp-action="Index">Bảng Tin</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="flex-grow-1 py-4">
            <div class="container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>

        <footer class="footer py-3 bg-white border-top text-muted small">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center">
                <span>&copy; 2026 <strong>ApartmentHub</strong> · Hệ thống quản lý chung cư</span>
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a>
            </div>
        </footer>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sidebar Mobile Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('appSidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });

                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
