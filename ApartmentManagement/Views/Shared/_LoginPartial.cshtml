@using Microsoft.AspNetCore.Identity
@using ApartmentManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
        var roleName = roles.FirstOrDefault() ?? "Người dùng";

        <li class="nav-item me-2">
            <span class="badge bg-light text-primary border px-2 py-1">
                @roleName
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
                👤 @(currentUser?.FullName ?? User.Identity?.Name)
            </a>
        </li>
        <li class="nav-item ms-2">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    Đăng xuất
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item ms-2">
            <a class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" asp-area="Identity" asp-page="/Account/Login">
                Đăng nhập
            </a>
        </li>
    }
</ul>
