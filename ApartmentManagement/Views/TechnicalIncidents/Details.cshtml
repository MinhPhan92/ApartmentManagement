@model ApartmentManagement.Models.TechnicalIncident
@{
    ViewData["Title"] = $"Sự cố {Model.IncidentCode}";
    var isManagement = (bool)(ViewBag.IsManagement ?? false);
    var isAssignedTechnician = (bool)(ViewBag.IsAssignedTechnician ?? false);
    var rowVersionToken = Model.RowVersion.Length > 0 ? Convert.ToBase64String(Model.RowVersion) : "";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Sự cố kỹ thuật</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.IncidentCode</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h2 class="h3 fw-bold mb-0">@Model.IncidentCode — @Model.Title</h2>
            </div>
            <p class="text-muted small mb-0">
                <i class="bi bi-geo-alt"></i> Tòa nhà: <strong>@(Model.Building?.BuildingName ?? "Chung cư")</strong> · Vị trí: <strong>@Model.Location</strong>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- UC48: Tiếp nhận báo cáo sự cố (Ban quản lý) -->
            @if (isManagement && Model.Status == "Reported")
            {
                <button type="button" class="btn btn-warning text-dark fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#acknowledgeModal">
                    <i class="bi bi-check-circle-fill"></i> Tiếp nhận sự cố (UC48)
                </button>
            }

            <!-- UC49: Phân công kỹ thuật viên (Ban quản lý) -->
            @if (isManagement && (Model.Status == "Reported" || Model.Status == "Acknowledged" || Model.Status == "Assigned"))
            {
                <a asp-action="Assign" asp-route-id="@Model.TechnicalIncidentId" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-person-plus-fill"></i> Phân công KTV (UC49)
                </a>
            }

            <!-- Kỹ thuật viên bắt đầu xử lý -->
            @if (isAssignedTechnician && Model.Status == "Assigned")
            {
                <button type="button" class="btn btn-info text-white fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#startWorkModal">
                    <i class="bi bi-play-circle-fill"></i> Bắt đầu xử lý
                </button>
            }

            <!-- Kỹ thuật viên hoàn tất và báo cáo kết quả -->
            @if (isAssignedTechnician && (Model.Status == "InProgress" || Model.Status == "Assigned"))
            {
                <a asp-action="Resolve" asp-route-id="@Model.TechnicalIncidentId" class="btn btn-success fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-clipboard-check-fill"></i> Báo cáo kết quả xử lý
                </a>
            }

            <!-- UC50: Ban quản lý nghiệm thu và đóng sự cố -->
            @if (isManagement && Model.Status == "Resolved")
            {
                <button type="button" class="btn btn-success fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#closeModal">
                    <i class="bi bi-patch-check-fill"></i> Nghiệm thu & Đóng sự cố (UC50)
                </button>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Column: Incident Information -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h3 class="h5 fw-bold mb-0">Nội dung sự cố kỹ thuật</h3>
                    <div>
                        <span class="badge bg-light text-dark border me-1">@Model.Category</span>
                        @if (Model.Priority == "Critical")
                        {
                            <span class="badge bg-danger">Khẩn cấp</span>
                        }
                        else if (Model.Priority == "High")
                        {
                            <span class="badge bg-warning text-dark">Cao</span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info-emphasis">@Model.Priority</span>
                        }
                    </div>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Mô tả hiện trạng:</span>
                        <p class="mb-0 text-break" style="white-space: pre-line;">@Model.Description</p>
                    </div>

                    <div class="row g-2 small text-muted">
                        <div class="col-sm-6">
                            <i class="bi bi-person-fill"></i> Người báo cáo: <strong>@(Model.ReportedByUser?.FullName ?? "Kỹ thuật viên")</strong>
                        </div>
                        <div class="col-sm-6">
                            <i class="bi bi-clock-fill"></i> Thời điểm: <strong>@Model.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resolution Card (if resolved or closed) -->
            @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-success border-4">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h3 class="h5 fw-bold text-success mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i> Kết quả xử lý sự cố (Kỹ thuật viên)
                        </h3>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="mb-3">
                            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Nội dung đã khắc phục:</span>
                            <div class="p-3 bg-success-subtle text-success-emphasis rounded-3" style="white-space: pre-line;">
                                @Model.ResolutionNotes
                            </div>
                        </div>

                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(Model.SpareParts))
                            {
                                <div class="col-md-7">
                                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Vật tư / Linh kiện thay thế:</span>
                                    <div class="p-2 bg-light rounded-3 small font-monospace">@Model.SpareParts</div>
                                </div>
                            }
                            @if (Model.MaterialCost.HasValue)
                            {
                                <div class="col-md-5">
                                    <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Chi phí phát sinh:</span>
                                    <div class="p-2 bg-light rounded-3 fw-bold text-success fs-6">@Model.MaterialCost.Value.ToString("N0") đ</div>
                                </div>
                            }
                        </div>
                        @if (Model.ResolvedAt.HasValue)
                        {
                            <div class="small text-muted mt-3">
                                <i class="bi bi-clock"></i> Thời điểm hoàn thành: @Model.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Status History Timeline Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h3 class="h5 fw-bold mb-0">Nhật ký xử lý sự cố (Status History)</h3>
                    <span class="badge bg-light text-muted border">@Model.StatusHistory.Count bản ghi</span>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="timeline position-relative ps-4 border-start border-2 ms-2">
                        @foreach (var history in Model.StatusHistory)
                        {
                            <div class="timeline-item mb-4 position-relative">
                                <div class="position-absolute" style="left: -29px; top: 0;">
                                    <span class="badge rounded-circle p-2 bg-primary">
                                        <i class="bi bi-arrow-right text-white" style="font-size: 10px;"></i>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <strong class="text-primary">@history.NewStatus</strong>
                                        @if (!string.IsNullOrEmpty(history.PreviousStatus))
                                        {
                                            <small class="text-muted">(từ <em>@history.PreviousStatus</em>)</small>
                                        }
                                    </div>
                                    <span class="small text-muted">@history.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="small text-muted mb-1">
                                    Thực hiện bởi: <strong>@(history.ChangedByUser?.FullName ?? "Hệ thống")</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(history.NewTechnicianUserId))
                                {
                                    <div class="small mb-1 text-primary">
                                        <i class="bi bi-person-gear"></i> KTV phân công: <strong>@(history.NewTechnicianUser?.FullName ?? history.NewTechnicianUserId)</strong>
                                        @if (!string.IsNullOrEmpty(history.PreviousTechnicianUserId))
                                        {
                                            <span class="text-muted">(thay thế: @(history.PreviousTechnicianUser?.FullName ?? history.PreviousTechnicianUserId))</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(history.Note))
                                {
                                    <div class="p-2 bg-light rounded-3 small text-dark">
                                        @history.Note
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Summary & Metadata -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h3 class="h6 fw-bold mb-0">Trạng thái hiện tại</h3>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="mb-3 text-center">
                        @if (Model.Status == "Reported")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-hourglass-top"></i> Chờ tiếp nhận
                            </span>
                        }
                        else if (Model.Status == "Acknowledged")
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle"></i> Đã tiếp nhận
                            </span>
                        }
                        else if (Model.Status == "Assigned")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-person-check-fill"></i> Đã phân công KTV
                            </span>
                        }
                        else if (Model.Status == "InProgress")
                        {
                            <span class="badge bg-info text-white fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-gear-wide-connected"></i> Đang xử lý
                            </span>
                        }
                        else if (Model.Status == "Resolved")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-clipboard-check-fill"></i> Đã khắc phục xong
                            </span>
                        }
                        else if (Model.Status == "Closed")
                        {
                            <span class="badge bg-dark-subtle text-dark border fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-patch-check-fill"></i> Đã nghiệm thu & đóng
                            </span>
                        }
                    </div>

                    <dl class="row mb-0 g-2 small">
                        <dt class="col-5 text-muted">KTV phụ trách:</dt>
                        <dd class="col-7 fw-semibold @(string.IsNullOrEmpty(Model.AssignedTechnicianUserId) ? "text-muted fst-italic" : "text-primary")">
                            @(Model.AssignedTechnicianUser?.FullName ?? "Chưa phân công")
                        </dd>

                        @if (Model.ScheduledDate.HasValue)
                        {
                            <dt class="col-5 text-muted">Hạn chót:</dt>
                            <dd class="col-7 fw-semibold text-danger">@Model.ScheduledDate.Value.ToString("dd/MM/yyyy")</dd>
                        }

                        @if (Model.AcknowledgedByUser != null)
                        {
                            <dt class="col-5 text-muted">Người tiếp nhận:</dt>
                            <dd class="col-7">@Model.AcknowledgedByUser.FullName</dd>
                        }

                        @if (Model.ClosedByUser != null)
                        {
                            <dt class="col-5 text-muted">Người nghiệm thu:</dt>
                            <dd class="col-7">@Model.ClosedByUser.FullName</dd>
                            <dt class="col-5 text-muted">Ngày đóng:</dt>
                            <dd class="col-7">@Model.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tiếp nhận sự cố (UC48) -->
@if (isManagement && Model.Status == "Reported")
{
    <div class="modal fade" id="acknowledgeModal" tabindex="-1" aria-labelledby="acknowledgeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="acknowledgeModalLabel">Tiếp nhận báo cáo sự cố (UC48)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Acknowledge" method="post">
                    <div class="modal-body py-4">
                        <p class="mb-2">Bạn xác nhận Ban quản lý đã nắm thông tin và tiếp nhận sự cố <strong>@Model.IncidentCode</strong>?</p>
                        <div class="mb-2">
                            <label for="ackNote" class="form-label small fw-semibold text-muted">Ghi chú tiếp nhận (tùy chọn):</label>
                            <textarea id="ackNote" name="note" class="form-control rounded-3" rows="3" placeholder="Nhập chỉ đạo hoặc ghi chú ban đầu của Ban quản lý..."></textarea>
                        </div>
                        <input type="hidden" name="id" value="@Model.TechnicalIncidentId" />
                        <input type="hidden" name="rowVersionBase64" value="@rowVersionToken" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold rounded-3 px-4">Xác nhận tiếp nhận</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Kỹ thuật viên bắt đầu xử lý -->
@if (isAssignedTechnician && Model.Status == "Assigned")
{
    <div class="modal fade" id="startWorkModal" tabindex="-1" aria-labelledby="startWorkModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="startWorkModalLabel">Bắt đầu tiến hành xử lý sự cố</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="StartWork" method="post">
                    <div class="modal-body py-4">
                        <p class="mb-2">Chuyển trạng thái sự cố sang <strong>Đang xử lý</strong>?</p>
                        <div class="mb-2">
                            <label for="startNote" class="form-label small fw-semibold text-muted">Ghi chú kiểm tra thực tế (tùy chọn):</label>
                            <textarea id="startNote" name="note" class="form-control rounded-3" rows="3" placeholder="Nhập ghi chú sơ bộ khi đến hiện trường..."></textarea>
                        </div>
                        <input type="hidden" name="id" value="@Model.TechnicalIncidentId" />
                        <input type="hidden" name="rowVersionBase64" value="@rowVersionToken" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-info text-white fw-semibold rounded-3 px-4">Bắt đầu xử lý</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Nghiệm thu & Đóng sự cố (UC50) -->
@if (isManagement && Model.Status == "Resolved")
{
    <div class="modal fade" id="closeModal" tabindex="-1" aria-labelledby="closeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-success" id="closeModalLabel">Nghiệm thu & Đóng sự cố kỹ thuật (UC50)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Close" method="post">
                    <div class="modal-body py-4">
                        <p class="mb-2">Xác nhận sự cố <strong>@Model.IncidentCode</strong> đã được kỹ thuật viên khắc phục hoàn tất và đạt tiêu chuẩn an toàn vận hành?</p>
                        <div class="mb-2">
                            <label for="closeNote" class="form-label small fw-semibold text-muted">Biên bản nghiệm thu / Ghi chú đóng sự cố:</label>
                            <textarea id="closeNote" name="note" class="form-control rounded-3" rows="3" placeholder="Ghi nhận đánh giá nghiệm thu của Ban quản lý..."></textarea>
                        </div>
                        <input type="hidden" name="id" value="@Model.TechnicalIncidentId" />
                        <input type="hidden" name="rowVersionBase64" value="@rowVersionToken" />
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-success fw-semibold rounded-3 px-4">Xác nhận nghiệm thu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

