@model IEnumerable<ApartmentManagement.Models.TechnicalIncident>
@{
    ViewData["Title"] = "Quản Lý Sự Cố Kỹ Thuật";
    var activeTab = ViewBag.ActiveTab as string ?? "all";
    var isTechnicianOnly = (bool)(ViewBag.IsTechnicianOnly ?? false);
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentPriority = ViewBag.CurrentPriority as string;
    var currentBuildingId = ViewBag.CurrentBuildingId as int?;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">⚠️ Quản Lý Sự Cố Kỹ Thuật</h2>
            <p class="text-muted mb-0">Hệ thống tiếp nhận, phân công và giám sát khắc phục sự cố kỹ thuật hạ tầng tòa nhà (UC47–UC50).</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-warning text-dark fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i> Báo cáo sự cố mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs Navigation -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 @(activeTab == "all" ? "active" : "bg-white text-dark shadow-sm")"
               asp-action="Index" asp-route-tab="all">
                <i class="bi bi-list-task me-1"></i> Tất cả sự cố
            </a>
        </li>
        @if (User.IsInRole(ApartmentManagement.Common.Security.AppRoles.Technician))
        {
            <li class="nav-item">
                <a class="nav-link rounded-pill px-4 @(activeTab == "my-assigned" ? "active" : "bg-white text-dark shadow-sm")"
                   asp-action="Index" asp-route-tab="my-assigned">
                    <i class="bi bi-person-workspace me-1"></i> Sự cố của tôi
                </a>
            </li>
        }
    </ul>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3">
                <input type="hidden" name="tab" value="@activeTab" />
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control rounded-3" placeholder="Mã sự cố, vị trí, tiêu đề..." />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tòa nhà</label>
                    <select name="buildingId" class="form-select rounded-3" asp-items="ViewBag.BuildingOptions">
                        <option value="">-- Tất cả tòa nhà --</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Trạng thái</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="">-- Tất cả --</option>
                        <option value="Reported" selected="@(currentStatus == "Reported")">Chờ tiếp nhận</option>
                        <option value="Acknowledged" selected="@(currentStatus == "Acknowledged")">Đã tiếp nhận</option>
                        <option value="Assigned" selected="@(currentStatus == "Assigned")">Đã phân công</option>
                        <option value="InProgress" selected="@(currentStatus == "InProgress")">Đang xử lý</option>
                        <option value="Resolved" selected="@(currentStatus == "Resolved")">Đã khắc phục</option>
                        <option value="Closed" selected="@(currentStatus == "Closed")">Đã nghiệm thu</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Mức độ ưu tiên</label>
                    <select name="priority" class="form-select rounded-3">
                        <option value="">-- Tất cả --</option>
                        <option value="Low" selected="@(currentPriority == "Low")">Thấp</option>
                        <option value="Normal" selected="@(currentPriority == "Normal")">Bình thường</option>
                        <option value="High" selected="@(currentPriority == "High")">Cao</option>
                        <option value="Critical" selected="@(currentPriority == "Critical")">Khẩn cấp</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 flex-grow-1">
                        <i class="bi bi-funnel-fill"></i> Lọc
                    </button>
                    <a asp-action="Index" asp-route-tab="@activeTab" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã sự cố</th>
                        <th>Tiêu đề & Vị trí</th>
                        <th>Loại sự cố</th>
                        <th>Độ ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Người báo cáo</th>
                        <th>KTV phụ trách</th>
                        <th>Ngày báo cáo</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                            <span>Không có sự cố kỹ thuật nào phù hợp với điều kiện tìm kiếm.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-semibold text-primary">
                                <a asp-action="Details" asp-route-id="@item.TechnicalIncidentId" class="text-decoration-none">
                                    @item.IncidentCode
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted"><i class="bi bi-geo-alt"></i> @(item.Building?.BuildingName ?? "") — @item.Location</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category</span>
                            </td>
                            <td>
                                @if (item.Priority == "Critical")
                                {
                                    <span class="badge bg-danger">Khẩn cấp</span>
                                }
                                else if (item.Priority == "High")
                                {
                                    <span class="badge bg-warning text-dark">Cao</span>
                                }
                                else if (item.Priority == "Low")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Thấp</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis">Bình thường</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Reported")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Chờ tiếp nhận</span>
                                }
                                else if (item.Status == "Acknowledged")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đã tiếp nhận</span>
                                }
                                else if (item.Status == "Assigned")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã phân công</span>
                                }
                                else if (item.Status == "InProgress")
                                {
                                    <span class="badge bg-info text-white">Đang xử lý</span>
                                }
                                else if (item.Status == "Resolved")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đã khắc phục</span>
                                }
                                else if (item.Status == "Closed")
                                {
                                    <span class="badge bg-dark-subtle text-dark border">Đã nghiệm thu</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>
                                <span class="small">@(item.ReportedByUser?.FullName ?? "Kỹ thuật viên")</span>
                            </td>
                            <td>
                                <span class="small fw-medium @(string.IsNullOrEmpty(item.AssignedTechnicianUserId) ? "text-muted fst-italic" : "text-primary")">
                                    @(item.AssignedTechnicianUser?.FullName ?? "Chưa phân công")
                                </span>
                            </td>
                            <td class="small text-muted">
                                @item.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.TechnicalIncidentId" class="btn btn-sm btn-outline-primary rounded-3">
                                    Chi tiết <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

