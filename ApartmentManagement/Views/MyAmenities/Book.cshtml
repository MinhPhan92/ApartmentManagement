@model ApartmentManagement.Models.AmenityBooking

@{
    ViewData["Title"] = "Đặt Tiện ích";
    var amenity = ViewBag.Amenity as ApartmentManagement.Models.Amenity;
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-plus me-2"></i>Đặt chỗ tiện ích: @amenity?.Name</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info py-2 small mb-4">
                        <div><strong>Vị trí:</strong> @(amenity?.Location ?? "Khuôn viên chung") | <strong>Sức chứa:</strong> @amenity?.Capacity người</div>
                        <div><strong>Giờ mở cửa:</strong> @amenity?.OpenTime.ToString(@"hh\:mm") - @amenity?.CloseTime.ToString(@"hh\:mm") | <strong>Phí:</strong> @(amenity?.PricePerHour > 0 ? $"{amenity?.PricePerHour:N0} đ/giờ" : "Miễn phí")</div>
                    </div>

                    <form asp-action="Book" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AmenityId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="BookingDate" class="form-label fw-bold"></label>
                            <input asp-for="BookingDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="BookingDate" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label fw-bold"></label>
                                <input asp-for="StartTime" class="form-control" type="time" />
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndTime" class="form-label fw-bold"></label>
                                <input asp-for="EndTime" class="form-control" type="time" />
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NumberOfGuests" class="form-label fw-bold"></label>
                            <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" max="@(amenity?.Capacity ?? 20)" />
                            <span asp-validation-for="NumberOfGuests" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm nếu có..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4">Xác nhận đặt chỗ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
