@model IEnumerable<ApartmentManagement.Models.AmenityBooking>

@{
    ViewData["Title"] = "Tiện ích của tôi";
    var amenities = ViewBag.Amenities as IEnumerable<ApartmentManagement.Models.Amenity> ?? Enumerable.Empty<ApartmentManagement.Models.Amenity>();
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-1">Dịch vụ & Tiện ích cư dân</h2>
            <p class="text-muted small mb-0">Đặt chỗ trước các tiện ích chung cư và quản lý lịch sử đặt của bạn</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tiện ích sẵn có -->
    <h5 class="fw-bold mb-3"><i class="bi bi-grid text-primary me-2"></i>Danh sách tiện ích sẵn có</h5>
    <div class="row row-cols-1 row-cols-md-3 g-3 mb-5">
        @foreach (var a in amenities.Where(x => x.IsActive))
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-primary mb-0">@a.Name</h6>
                            <span class="badge bg-success">Đang mở</span>
                        </div>
                        <p class="text-muted small mb-2">@a.Description</p>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="bi bi-clock me-1"></i> Giờ mở cửa: @a.OpenTime.ToString(@"hh\:mm") - @a.CloseTime.ToString(@"hh\:mm")</li>
                            <li><i class="bi bi-people me-1"></i> Sức chứa: @a.Capacity người</li>
                            <li><i class="bi bi-tag me-1"></i> Phí: @(a.PricePerHour > 0 ? $"{a.PricePerHour:N0} đ/giờ" : "Miễn phí")</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <a asp-action="Book" asp-route-id="@a.AmenityId" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-calendar-plus me-1"></i> Đặt lịch ngay
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Lịch đặt của tôi -->
    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-secondary me-2"></i>Lịch sử đặt tiện ích của bạn</h5>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Tiện ích</th>
                        <th>Ngày sử dụng</th>
                        <th>Khung giờ</th>
                        <th>Số người</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Bạn chưa có lịch đặt tiện ích nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.AmenityBookingId</td>
                            <td><span class="fw-bold">@item.Amenity?.Name</span></td>
                            <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-light text-dark border">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span></td>
                            <td>@item.NumberOfGuests người</td>
                            <td>
                                @if (item.Status == "Đã xác nhận")
                                {
                                    <span class="badge bg-success">Đã xác nhận</span>
                                }
                                else if (item.Status == "Đã hủy")
                                {
                                    <span class="badge bg-secondary">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                            </td>
                            <td><small class="text-muted">@(item.Notes ?? "-")</small></td>
                            <td>
                                @if (item.Status != "Đã hủy" && item.BookingDate.Date >= DateTime.Today)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.AmenityBookingId" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy lịch này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy lịch</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
