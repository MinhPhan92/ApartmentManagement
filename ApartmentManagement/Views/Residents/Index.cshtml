@model IEnumerable<ApartmentManagement.Models.Resident>
@{
    ViewData["Title"] = "Quản lý cư dân";
}
<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-1">👥 Quản Lý Cư Dân</h2>
            <p class="text-muted mb-0">Quản lý hồ sơ cá nhân và tài khoản truy cập của cư dân.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">➕ Cấp tài khoản cư dân</a>
    </div>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
    <div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6"><input name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo họ tên, email hoặc CCCD/CMND..." /></div>
            <div class="col-auto"><button class="btn btn-secondary">Tìm kiếm</button> <a asp-action="Index" class="btn btn-link">Đặt lại</a></div>
        </form>
    </div></div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th class="ps-4">Cư dân</th><th>CCCD/CMND</th><th>Liên hệ</th><th>Căn hộ</th><th>Trạng thái</th><th class="text-end pe-4">Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Any()) {
                @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4"><strong>@item.User.FullName</strong><div class="small text-muted">@item.User.Email</div></td>
                        <td>@item.CitizenId</td><td>@(item.EmergencyContact ?? "Chưa có")</td>
                        <td><span class="badge bg-info text-dark">@item.ApartmentResidents.Count hồ sơ</span></td>
                        <td><span class="badge @(item.User.IsActive ? "bg-success" : "bg-secondary")">@(item.User.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")</span></td>
                        <td class="text-end pe-4"><div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@item.ResidentId" class="btn btn-outline-info">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.ResidentId" class="btn btn-outline-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.ResidentId" class="btn btn-outline-danger">Xóa</a>
                        </div></td>
                    </tr>
                }
            } else { <tr><td colspan="6" class="text-center text-muted py-5">Không tìm thấy cư dân.</td></tr> }
            </tbody>
        </table>
    </div></div>
</div>
