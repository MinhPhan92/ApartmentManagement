@model ApartmentManagement.Models.ResidentEditViewModel
@{ ViewData["Title"] = "Chỉnh sửa cư dân"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-9">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-warning p-4"><h4 class="mb-0">✏️ Chỉnh Sửa Hồ Sơ Cư Dân</h4></div>
        <div class="card-body p-4"><form method="post">
            <input asp-for="ResidentId" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="CitizenId" class="form-label"></label><input asp-for="CitizenId" class="form-control" /><span asp-validation-for="CitizenId" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">Chưa xác định</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
                <div class="col-md-8"><label asp-for="EmergencyContact" class="form-label"></label><input asp-for="EmergencyContact" class="form-control" /></div>
                <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
            </div><hr class="my-4" /><div class="text-end"><a asp-action="Details" asp-route-id="@Model.ResidentId" class="btn btn-outline-secondary me-2">Hủy</a><button class="btn btn-warning">💾 Cập nhật</button></div>
        </form></div>
    </div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
