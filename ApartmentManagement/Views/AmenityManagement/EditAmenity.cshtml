@model ApartmentManagement.ViewModels.AmenityDefinitionViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Tiện Ích: " + Model.Name;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="mb-3">
                <a asp-action="Amenities" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại danh mục
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h4 class="h5 fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Tiện Ích: @Model.Name</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditAmenity" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AmenityId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Location" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Location" class="form-control" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small text-muted"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Capacity" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Capacity" type="number" min="1" max="1000" class="form-control" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PricePerHour" class="form-label fw-semibold small text-muted"></label>
                                <div class="input-group">
                                    <input asp-for="PricePerHour" type="number" step="1000" min="0" class="form-control" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="PricePerHour" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 d-flex align-items-center pt-3">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                                    <label class="form-check-label fs-6 fw-semibold" for="isActiveSwitch">Cho phép đặt chỗ</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OpenTime" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="OpenTime" type="time" class="form-control" />
                                <span asp-validation-for="OpenTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CloseTime" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="CloseTime" type="time" class="form-control" />
                                <span asp-validation-for="CloseTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-4 mt-2 border-top">
                            <a asp-action="Amenities" class="btn btn-outline-secondary rounded-3 px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                                <i class="bi bi-save me-1"></i> Cập nhật tiện ích
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

