@model IEnumerable<ApartmentManagement.Models.Amenity>
@{
    ViewData["Title"] = "Cấu Hình Danh Mục Tiện Ích";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="mb-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> Quay lại hàng đợi duyệt
                </a>
            </div>
            <h2 class="fw-bold mb-1">⚙️ Danh Mục Tiện Ích Tòa Nhà</h2>
            <p class="text-muted mb-0">Quản lý các tiện ích chung cư phục vụ cư dân: Giờ mở cửa, sức chứa, đơn giá và trạng thái.</p>
        </div>
        <div>
            <a asp-action="CreateAmenity" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-pill px-4">
                <i class="bi bi-plus-circle-fill"></i> Thêm tiện ích mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4">Tên tiện ích</th>
                        <th>Vị trí</th>
                        <th>Khung giờ</th>
                        <th>Sức chứa</th>
                        <th>Đơn giá / giờ</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Name</div>
                                <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "--" : item.Description)</small>
                            </td>
                            <td>
                                <span><i class="bi bi-geo-alt text-danger"></i> @(string.IsNullOrWhiteSpace(item.Location) ? "Chung" : item.Location)</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.OpenTime.ToString(@"hh\:mm") - @item.CloseTime.ToString(@"hh\:mm")
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold">@item.Capacity người</span>
                            </td>
                            <td>
                                @if (item.PricePerHour > 0)
                                {
                                    <span class="fw-bold text-success">@item.PricePerHour.ToString("N0") đ</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">Miễn phí</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-check-circle-fill"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                        <i class="bi bi-pause-circle-fill"></i> Tạm ngưng
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditAmenity" asp-route-id="@item.AmenityId" class="btn btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteAmenity" asp-route-id="@item.AmenityId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tiện ích này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa tiện ích">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

