@model IEnumerable<ApartmentManagement.Models.Complaint>

@{
    ViewData["Title"] = "Ý Kiến & Khiếu Nại";
    var isResident = User.IsInRole("Resident") && !User.IsInRole("SystemAdmin") && !User.IsInRole("Manager");
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">📢 Phản Ánh & Khiếu Nại</h2>
            <p class="text-muted mb-0">
                @(isResident ? "Theo dõi tiến độ tiếp nhận và phản hồi từ Ban Quản Lý đối với các ý kiến đóng góp của bạn." : "Danh sách phản ánh, khiếu nại của cư dân cần tiếp nhận và giải quyết.")
            </p>
        </div>
        <div>
            @if (isResident)
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
                    ✍️ Gửi phản ánh mới
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>✅</span>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>⚠️</span>
                <strong>@TempData["ErrorMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3">
                <div class="col-12 col-md-5 col-lg-4">
                    <label class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control rounded-3" placeholder="Nhập tiêu đề, nội dung, căn hộ..." />
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small fw-semibold text-muted">Trạng thái</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Chờ tiếp nhận" selected="@(selectedStatus == "Chờ tiếp nhận")">⏳ Chờ tiếp nhận</option>
                        <option value="Đang xử lý" selected="@(selectedStatus == "Đang xử lý")">⚙️ Đang xử lý</option>
                        <option value="Đã xử lý" selected="@(selectedStatus == "Đã xử lý")">✅ Đã xử lý</option>
                        <option value="Từ chối" selected="@(selectedStatus == "Từ chối")">❌ Từ chối</option>
                        <option value="Đã hủy" selected="@(selectedStatus == "Đã hủy")">⚪ Đã hủy</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <label class="form-label small fw-semibold text-muted">Danh mục</label>
                    <select name="category" class="form-select rounded-3">
                        <option value="">-- Tất cả danh mục --</option>
                        <option value="An ninh" selected="@(selectedCategory == "An ninh")">🛡️ An ninh</option>
                        <option value="Vệ sinh" selected="@(selectedCategory == "Vệ sinh")">🧹 Vệ sinh</option>
                        <option value="Tiếng ồn" selected="@(selectedCategory == "Tiếng ồn")">🔊 Tiếng ồn</option>
                        <option value="Tiện ích / Thiết bị" selected="@(selectedCategory == "Tiện ích / Thiết bị")">💡 Tiện ích / Thiết bị</option>
                        <option value="Dịch vụ khác" selected="@(selectedCategory == "Dịch vụ khác")">📦 Dịch vụ khác</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-primary rounded-3 px-3 w-100">
                        🔍 Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-light rounded-3 text-muted">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Complaints Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tiêu đề phản ánh</th>
                        <th>Danh mục</th>
                        @if (!isResident)
                        {
                            <th>Cư dân</th>
                        }
                        <th>Căn hộ</th>
                        <th>Thời điểm gửi</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isResident ? 6 : 7)" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">💬</div>
                                <p class="mb-0">Chưa có phản ánh nào được ghi nhận.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.ComplaintId" class="fw-bold text-decoration-none text-dark d-block">
                                        @item.Title
                                    </a>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 280px;">
                                        @item.Content
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @item.Category
                                    </span>
                                </td>
                                @if (!isResident)
                                {
                                    <td>
                                        <div class="fw-semibold">@(item.Resident?.User?.FullName ?? "Chưa rõ")</div>
                                        <small class="text-muted">CCCD: @(item.Resident?.CitizenId ?? "-")</small>
                                    </td>
                                }
                                <td>
                                    @if (item.Apartment != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            🚪 @item.Apartment.ApartmentCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Khu vực chung</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Chờ tiếp nhận":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                                ⏳ Chờ tiếp nhận
                                            </span>
                                            break;
                                        case "Đang xử lý":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">
                                                ⚙️ Đang xử lý
                                            </span>
                                            break;
                                        case "Đã xử lý":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                ✅ Đã xử lý
                                            </span>
                                            break;
                                        case "Từ chối":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                ❌ Từ chối
                                            </span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
                                                ⚪ Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.ComplaintId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Chi tiết
                                        </a>

                                        @if (!isResident && item.Status != "Đã hủy" && item.Status != "Đã xử lý" && item.Status != "Từ chối")
                                        {
                                            <a asp-action="Process" asp-route-id="@item.ComplaintId" class="btn btn-sm btn-primary rounded-pill px-3">
                                                Xử lý
                                            </a>
                                        }

                                        @if (isResident && item.Status == "Chờ tiếp nhận")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@item.ComplaintId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn rút phản ánh này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Rút đơn
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
