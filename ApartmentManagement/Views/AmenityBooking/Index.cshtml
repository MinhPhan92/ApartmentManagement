@model IEnumerable<ApartmentManagement.Models.Amenity>
@{
    ViewData["Title"] = "Dịch Vụ & Tiện Ích Chung Cư";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">🎾 Đăng Ký Tiện Ích Chung Cư</h2>
            <p class="text-muted mb-0">Đặt chỗ sử dụng các tiện ích sinh hoạt cộng đồng: Sân Tennis, Khu BBQ, Hồ bơi, Phòng họp...</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MyBookings" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-pill px-3">
                <i class="bi bi-clock-history"></i> Lịch đặt của tôi
            </a>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager"))
            {
                <a asp-controller="AmenityManagement" asp-action="Index" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-pill px-3">
                    <i class="bi bi-shield-check"></i> Quản lý phê duyệt (BQL)
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Facility Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var amenity in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-shadow transition">
                    <div class="card-header bg-gradient bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="badge @(amenity.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") rounded-pill px-3 py-1">
                            <i class="bi @(amenity.IsActive ? "bi-check-circle-fill" : "bi-pause-circle-fill")"></i>
                            @(amenity.IsActive ? "Đang mở cửa" : "Tạm ngưng")
                        </span>
                        @if (amenity.PricePerHour > 0)
                        {
                            <span class="fw-bold text-primary">@amenity.PricePerHour.ToString("N0") đ<small class="text-muted fw-normal">/giờ</small></span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">Miễn phí</span>
                        }
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="card-title fw-bold text-dark mb-2">@amenity.Name</h4>
                        <p class="card-text text-muted small flex-grow-1 mb-3" style="min-height: 48px;">
                            @(string.IsNullOrWhiteSpace(amenity.Description) ? "Tiện ích tiêu chuẩn phục vụ cư dân khu căn hộ." : amenity.Description)
                        </p>

                        <div class="bg-light rounded-3 p-3 mb-3 small">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Vị trí:</span>
                                <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(amenity.Location) ? "Khuôn viên chung" : amenity.Location)</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted"><i class="bi bi-people-fill text-primary me-1"></i>Sức chứa:</span>
                                <span class="fw-semibold text-dark">Tối đa @amenity.Capacity người</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted"><i class="bi bi-clock-fill text-warning me-1"></i>Khung giờ:</span>
                                <span class="fw-semibold text-dark">@amenity.OpenTime.ToString(@"hh\:mm") - @amenity.CloseTime.ToString(@"hh\:mm")</span>
                            </div>
                        </div>

                        @if (amenity.IsActive)
                        {
                            <a asp-action="Create" asp-route-amenityId="@amenity.AmenityId" class="btn btn-primary w-100 rounded-3 fw-semibold py-2 shadow-sm d-flex justify-content-center align-items-center gap-2">
                                <i class="bi bi-calendar-plus"></i> Đặt chỗ ngay
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100 rounded-3 py-2 disabled" disabled>
                                <i class="bi bi-slash-circle"></i> Tạm ngưng hoạt động
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

