@model ApartmentManagement.Models.Amenity

@{
    ViewData["Title"] = "Thêm Tiện ích mới";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Thêm Tiện ích mới</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="VD: Bể bơi vô cực, Phòng Gym, Khu BBQ ngoài trời..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả tiện ích, quy định sử dụng..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label"></label>
                                <input asp-for="Location" class="form-control" placeholder="VD: Tầng 4 - Tòa A" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Capacity" class="form-label fw-bold"></label>
                                <input asp-for="Capacity" class="form-control" type="number" min="1" max="1000" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="OpenTime" class="form-label fw-bold"></label>
                                <input asp-for="OpenTime" class="form-control" type="time" />
                                <span asp-validation-for="OpenTime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CloseTime" class="form-label fw-bold"></label>
                                <input asp-for="CloseTime" class="form-control" type="time" />
                                <span asp-validation-for="CloseTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PricePerHour" class="form-label"></label>
                                <input asp-for="PricePerHour" class="form-control" type="number" step="1000" min="0" placeholder="0 = Miễn phí" />
                            </div>
                            <div class="col-md-6 d-flex align-items-center pt-4">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-bold"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary">Lưu tiện ích</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
