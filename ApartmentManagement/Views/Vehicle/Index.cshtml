@model IEnumerable<ApartmentManagement.Models.Vehicle>

@{
    ViewData["Title"] = "Quản Lý Phương Tiện";
    var isResident = User.IsInRole("Resident") && !User.IsInRole("SystemAdmin") && !User.IsInRole("Manager");
    var selectedStatus = ViewBag.SelectedStatus as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">🏍️ Quản Lý Phương Tiện</h2>
            <p class="text-muted mb-0">
                @(isResident ? "Danh sách và trạng thái phương tiện của bạn đang đăng ký tại tòa nhà." : "Danh sách đăng ký phương tiện của toàn bộ cư dân.")
            </p>
        </div>
        <div>
            @if (isResident)
            {
                <a asp-action="Register" class="btn btn-primary shadow-sm rounded-pill px-4">
                    ➕ Đăng ký phương tiện mới
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>✅</span>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>⚠️</span>
                <strong>@TempData["ErrorMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3">
                <div class="col-12 col-md-6 col-lg-5">
                    <label class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control rounded-3" placeholder="Nhập biển số, dòng xe, tên cư dân..." />
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small fw-semibold text-muted">Trạng thái</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Chờ duyệt" selected="@(selectedStatus == "Chờ duyệt")">⏳ Chờ duyệt</option>
                        <option value="Đã duyệt" selected="@(selectedStatus == "Đã duyệt")">✅ Đã duyệt</option>
                        <option value="Từ chối" selected="@(selectedStatus == "Từ chối")">❌ Từ chối</option>
                        <option value="Đã hủy" selected="@(selectedStatus == "Đã hủy")">⚪ Đã hủy</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 col-lg-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-primary rounded-3 px-3">
                        🔍 Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-light rounded-3 text-muted">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Vehicles Table / Cards -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Biển số</th>
                        <th>Loại xe</th>
                        <th>Hãng / Dòng xe</th>
                        @if (!isResident)
                        {
                            <th>Chủ sở hữu</th>
                        }
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isResident ? 6 : 7)" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">🚗</div>
                                <p class="mb-0">Chưa có phương tiện nào được tìm thấy.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-dark fs-6 font-monospace px-3 py-2 border">
                                        @item.LicensePlate
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold">
                                        @(item.VehicleType == "Ô tô" ? "🚗 Ô tô" : item.VehicleType == "Xe máy" ? "🛵 Xe máy" : "🚲 " + item.VehicleType)
                                    </span>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.BrandModel) ? "-" : item.BrandModel)
                                    @if (!string.IsNullOrWhiteSpace(item.Color))
                                    {
                                        <small class="text-muted d-block">Màu: @item.Color</small>
                                    }
                                </td>
                                @if (!isResident)
                                {
                                    <td>
                                        <div class="fw-semibold">@(item.Resident?.User?.FullName ?? "Chưa rõ")</div>
                                        <small class="text-muted">CCCD: @(item.Resident?.CitizenId ?? "-")</small>
                                    </td>
                                }
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Chờ duyệt":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                                ⏳ Chờ duyệt
                                            </span>
                                            break;
                                        case "Đã duyệt":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                ✅ Đã duyệt
                                            </span>
                                            break;
                                        case "Từ chối":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                ❌ Từ chối
                                            </span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
                                                ⚪ Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Chi tiết
                                        </a>

                                        @if (!isResident && item.Status == "Chờ duyệt")
                                        {
                                            <a asp-action="Review" asp-route-id="@item.VehicleId" class="btn btn-sm btn-primary rounded-pill px-3">
                                                Xét duyệt
                                            </a>
                                        }

                                        @if (isResident && item.Status == "Chờ duyệt")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@item.VehicleId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đăng ký phương tiện này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
