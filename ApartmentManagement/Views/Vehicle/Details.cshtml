@model ApartmentManagement.Models.Vehicle

@{
    ViewData["Title"] = "Chi Tiết Phương Tiện: " + Model.LicensePlate;
    var isManagerOrAdmin = User.IsInRole("SystemAdmin") || User.IsInRole("Manager") || User.IsInRole("SuperAdmin") || User.IsInRole("BuildingManager");
    var isResident = User.IsInRole("Resident") && !isManagerOrAdmin;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwnerResident = isResident && Model.Resident?.UserId == currentUserId;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-3">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Phương Tiện</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.LicensePlate</li>
        </ol>
    </nav>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>✅</span>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>⚠️</span>
                <strong>@TempData["ErrorMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Info Card -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-primary text-white py-3 px-4 bg-gradient" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-white text-dark fs-5 font-monospace px-3 py-2 border shadow-sm">
                            @Model.LicensePlate
                        </span>
                        @switch (Model.Status)
                        {
                            case "Chờ duyệt":
                                <span class="badge bg-warning text-dark px-3 py-2">⏳ Chờ duyệt</span>
                                break;
                            case "Đã duyệt":
                                <span class="badge bg-success px-3 py-2">✅ Đã duyệt</span>
                                break;
                            case "Từ chối":
                                <span class="badge bg-danger px-3 py-2">❌ Từ chối</span>
                                break;
                            case "Đã hủy":
                                <span class="badge bg-secondary px-3 py-2">⚪ Đã hủy</span>
                                break;
                            case "Ngừng sử dụng":
                                <span class="badge bg-secondary text-white px-3 py-2">⛔ Ngừng sử dụng</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark px-3 py-2">@Model.Status</span>
                                break;
                        }
                    </div>
                    <h4 class="fw-bold mt-3 mb-0">@(Model.VehicleType == "Ô tô" ? "🚗" : "🛵") @Model.VehicleType</h4>
                    <small class="text-white-50">@(string.IsNullOrWhiteSpace(Model.BrandModel) ? "Chưa có thông tin dòng xe" : Model.BrandModel)</small>
                </div>

                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Biển số đăng ký:</span>
                            <span class="fw-bold fs-5 font-monospace text-primary">@Model.LicensePlate</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Loại phương tiện:</span>
                            <span class="fw-semibold">@Model.VehicleType</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Hãng / Kiểu dáng:</span>
                            <span class="fw-semibold">@(Model.BrandModel ?? "-")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Màu xe:</span>
                            <span class="fw-semibold">@(Model.Color ?? "-")</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">Thời điểm đăng ký:</span>
                            <span class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </li>
                        @if (Model.ParkingCard != null)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted">Thẻ bãi đỗ xe (RFID):</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary font-monospace fs-6 px-3 py-1">💳 @Model.ParkingCard?.CardCode</span>
                                    <span class="badge @(Model.ParkingCard!.Status == "Active" ? "bg-success" : (Model.ParkingCard!.Status == "Lost" ? "bg-danger" : "bg-secondary"))">@Model.ParkingCard?.Status</span>
                                    @if (Model.Status == "Đã duyệt" && Model.ParkingCard!.Status == "Active" && (isManagerOrAdmin || isOwnerResident))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0" data-bs-toggle="modal" data-bs-target="#lockCardModal" title="Báo mất / Khóa thẻ">
                                            🔒 Khóa thẻ
                                        </button>
                                    }
                                    @if (Model.Status == "Đã duyệt" && (Model.ParkingCard!.Status == "Lost" || Model.ParkingCard!.Status == "Locked") && isManagerOrAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" data-bs-toggle="modal" data-bs-target="#replaceCardModal" title="Cấp đổi thẻ mới">
                                            💳 Đổi thẻ
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                        else if (Model.Status == "Đã duyệt" && isManagerOrAdmin)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted">Thẻ bãi đỗ xe (RFID):</span>
                                <div>
                                    <span class="text-muted fst-italic me-2">Chưa cấp thẻ</span>
                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#replaceCardModal">
                                        💳 Cấp thẻ mới
                                    </button>
                                </div>
                            </li>
                        }
                        @if (Model.ReviewedAt.HasValue)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Thời điểm xử lý:</span>
                                <span class="fw-semibold">@Model.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
                        {
                            <li class="list-group-item px-0">
                                <span class="text-muted d-block mb-1">Ghi chú từ Ban Quản Lý:</span>
                                <div class="p-3 bg-light rounded-3 text-secondary border">
                                    @Model.ReviewNotes
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Quay lại danh sách
                        </a>

                        @if (isResident && Model.Status == "Chờ duyệt")
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.VehicleId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đăng ký phương tiện này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                    Hủy đăng ký
                                </button>
                            </form>
                        }

                        @if (isManagerOrAdmin && Model.Status == "Chờ duyệt")
                        {
                            <a asp-action="Review" asp-route-id="@Model.VehicleId" class="btn btn-primary rounded-pill px-4">
                                ⚖️ Xét duyệt phương tiện
                            </a>
                        }
                    

                        @if (Model.Status == "Đã duyệt" && (isOwnerResident || isManagerOrAdmin))
                        {
                            <form asp-action="Decommission" asp-route-id="@Model.VehicleId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn NGỪNG SỬ DỤNG phương tiện này? Thẻ bãi đỗ (nếu có) sẽ bị khóa.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning rounded-pill px-4">
                                    ⛔ Ngừng sử dụng
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            @if (isManagerOrAdmin && Model.Status == "Chờ duyệt")
            {
                <div class="card border-warning shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-warning bg-opacity-10 text-dark fw-bold py-3 px-4">
                        <span class="me-2">🛡️</span>Thẩm định đơn đăng ký phương tiện & Cấp thẻ
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-7">
                                <form asp-action="Approve" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="vehicleId" value="@Model.VehicleId" />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Mã thẻ từ bãi đỗ (RFID)</label>
                                        <input type="text" name="cardCode" class="form-control rounded-3 font-monospace" placeholder="Quét hoặc nhập mã thẻ từ (VD: CARD-0982)" />
                                        <div class="form-text small text-muted">Có thể để trống nếu cấp phát thẻ vật lý sau.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Ghi chú phê duyệt</label>
                                        <input type="text" name="reviewNotes" class="form-control rounded-3" placeholder="Ghi chú vị trí đỗ, hồ sơ giấy tờ..." />
                                    </div>

                                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                                        ✅ Chấp thuận & Cấp thẻ
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-5 border-start">
                                <form asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="vehicleId" value="@Model.VehicleId" />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-danger">Lý do từ chối (*)</label>
                                        <textarea name="rejectReason" class="form-control rounded-3" rows="3" required placeholder="Nêu rõ lý do (VD: Hết chỗ đỗ ô tô, giấy tờ không hợp lệ...)"></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                        ❌ Từ chối đơn
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Resident Owner Info Card -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0">Thông Tin Chủ Sở Hữu</h5>
                </div>
                <div class="card-body">
                    @if (Model.Resident != null)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 fs-3">
                                👤
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@(Model.Resident.User?.FullName ?? "Cư dân")</h6>
                                <small class="text-muted">Mã cư dân: #@Model.Resident.ResidentId</small>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Số CCCD / CMND:</span>
                                <span class="fw-semibold">@Model.Resident.CitizenId</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Email:</span>
                                <span class="fw-semibold">@(Model.Resident.User?.Email ?? "-")</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Số điện thoại:</span>
                                <span class="fw-semibold">@(Model.Resident.User?.PhoneNumber ?? "-")</span>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Không có thông tin cư dân liên kết.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal Báo mất / Khóa thẻ -->
@if (Model.Status == "Đã duyệt" && Model.ParkingCard != null && Model.ParkingCard!.Status == "Active" && (isManagerOrAdmin || isOwnerResident))
{
    <div class="modal fade" id="lockCardModal" tabindex="-1" aria-labelledby="lockCardModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-action="LockCard" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" value="@Model.VehicleId" />
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger" id="lockCardModalLabel">🔒 Xác nhận khóa thẻ bãi đỗ</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body py-3">
                        <div class="alert alert-warning rounded-3 small mb-3">
                            <strong>Lưu ý:</strong> Thẻ bãi đỗ hiện tại (<strong>@Model.ParkingCard?.CardCode</strong>) sẽ bị vô hiệu hóa ngay lập tức và không thể dùng để ra vào cổng bãi đỗ xe.
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lý do khóa / Báo mất thẻ (*)</label>
                            <textarea name="reason" class="form-control rounded-3" rows="3" required placeholder="Nêu rõ lý do: Bị mất thẻ, thẻ bị nứt gãy hỏng chip, nghi ngờ thất lạc..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Xác nhận khóa thẻ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Cấp đổi thẻ mới -->
@if (Model.Status == "Đã duyệt" && (Model.ParkingCard == null || Model.ParkingCard!.Status == "Lost" || Model.ParkingCard!.Status == "Locked") && isManagerOrAdmin)
{
    <div class="modal fade" id="replaceCardModal" tabindex="-1" aria-labelledby="replaceCardModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-action="ReplaceCard" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" value="@Model.VehicleId" />
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-primary" id="replaceCardModalLabel">💳 Cấp / Đổi thẻ bãi đỗ xe</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-muted small mb-3">
                            Phát hành thẻ từ RFID mới cho phương tiện biển số <strong>@Model.LicensePlate</strong>. Thẻ mới sẽ ở trạng thái <code>Active</code>.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mã thẻ từ bãi đỗ mới (RFID) (*)</label>
                            <input type="text" name="newCardCode" class="form-control rounded-3 font-monospace" required placeholder="Quét hoặc nhập mã thẻ mới (VD: CARD-9901)" />
                            <div class="form-text small text-muted">Mã thẻ không được trùng lặp với bất kỳ thẻ Active nào trên hệ thống.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Xác nhận cấp thẻ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
