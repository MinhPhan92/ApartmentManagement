@model ApartmentManagement.Models.Apartment

@{
    ViewData["Title"] = "Xác Nhận Xóa Căn Hộ: " + Model.ApartmentCode;
    var activeResidentCount = Model.ApartmentResidents?.Count(ar => ar.MoveOutDate == null) ?? 0;
    var totalResidentCount = Model.ApartmentResidents?.Count ?? 0;
    var canDelete = activeResidentCount == 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-3">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Căn Hộ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa: @Model.ApartmentCode</li>
                </ol>
            </nav>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <span>⚠️</span>
                        <strong>@TempData["ErrorMessage"]</strong>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white py-3 px-4 d-flex align-items-center gap-2">
                    <span class="fs-4">🗑️</span>
                    <div>
                        <h5 class="fw-bold mb-0">Xác Nhận Xóa Căn Hộ</h5>
                        <small class="text-white-50">Hành động này sẽ xóa căn hộ khỏi hệ thống</small>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (!canDelete)
                    {
                        <div class="alert alert-warning border-0 shadow-sm rounded-3 p-3 mb-4">
                            <div class="d-flex gap-2">
                                <span class="fs-4">⛔</span>
                                <div>
                                    <h6 class="fw-bold mb-1">Không thể xóa căn hộ này!</h6>
                                    <p class="mb-0 small text-dark">
                                        Căn hộ <strong>@Model.ApartmentCode</strong> hiện đang có <strong>@activeResidentCount cư dân</strong> đang lưu trú.
                                        Theo ràng buộc toàn vẹn dữ liệu, bạn cần hoàn tất thủ tục chuyển đi cho cư dân trước khi có thể xóa căn hộ này.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 p-3 mb-4">
                            <div class="d-flex gap-2">
                                <span class="fs-4">⚠️</span>
                                <div>
                                    <h6 class="fw-bold mb-1">Cảnh báo xóa dữ liệu</h6>
                                    <p class="mb-0 small text-danger">
                                        Bạn có chắc chắn muốn xóa căn hộ <strong>@Model.ApartmentCode</strong>? Nếu căn hộ đã có hợp đồng, hóa đơn hoặc lịch sử cư trú, hệ thống sẽ yêu cầu chuyển sang trạng thái "Không hoạt động" thay vì xóa vật lý.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-4 text-muted">Mã căn hộ:</dt>
                            <dd class="col-sm-8 fw-bold text-primary">@Model.ApartmentCode</dd>

                            <dt class="col-sm-4 text-muted">Tòa nhà:</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @(Model.Building?.BuildingCode) - @(Model.Building?.BuildingName)
                            </dd>

                            <dt class="col-sm-4 text-muted">Tầng:</dt>
                            <dd class="col-sm-8">Tầng @Model.Floor</dd>

                            <dt class="col-sm-4 text-muted">Diện tích:</dt>
                            <dd class="col-sm-8">@Model.Area.ToString("N1") m²</dd>

                            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-secondary">@Model.Status</span>
                            </dd>

                            <dt class="col-sm-4 text-muted">Cư dân đang ở:</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(activeResidentCount > 0 ? "bg-warning text-dark" : "bg-light text-dark border")">
                                    @activeResidentCount người
                                </span>
                            </dd>
                        </dl>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        @if (Model.Status != ApartmentStatus.Inactive && canDelete)
                        {
                            <form asp-action="Deactivate" asp-route-id="@Model.ApartmentId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary px-3" title="Chuyển sang Không hoạt động để bảo toàn lịch sử">
                                    🚫 Ngừng sử dụng
                                </button>
                            </form>
                        }
                        else
                        {
                            <div></div>
                        }

                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" asp-for="ApartmentId" />
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                    Quay lại
                                </a>
                                @if (canDelete)
                                {
                                    <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                                        🗑️ Xác Nhận Xóa
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-danger px-4 fw-semibold" disabled title="Căn hộ đang có cư dân lưu trú, không thể xóa.">
                                        Không Thể Xóa
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
