@model IEnumerable<ApartmentManagement.Models.Apartment>

@{
    ViewData["Title"] = "Quản Lý Căn Hộ";
    var buildings = ViewBag.Buildings as IEnumerable<ApartmentManagement.Models.Building> ?? Enumerable.Empty<ApartmentManagement.Models.Building>();
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-3">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản Lý Căn Hộ</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">🚪 Quản Lý Căn Hộ</h2>
            <p class="text-muted mb-0">Quản lý danh sách các căn hộ, phân bổ tầng, diện tích và tình trạng cư trú</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm d-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border: none;">
                <span>➕</span>
                <span>Thêm Căn Hộ Mới</span>
            </a>
        </div>
    </div>

    <!-- Alert notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>✅</span>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span>⚠️</span>
                <strong>@TempData["ErrorMessage"]</strong>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-semibold text-secondary">Lọc theo Tòa Nhà</label>
                    <select name="buildingId" class="form-select shadow-none">
                        <option value="">-- Tất cả tòa nhà --</option>
                        @foreach (var building in buildings)
                        {
                            <option value="@building.BuildingId" selected="@(selectedBuildingId == building.BuildingId)">
                                @building.BuildingCode - @building.BuildingName (@building.NumberOfFloors tầng)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Tìm kiếm theo Mã Căn Hộ</label>
                    <input type="text"
                           name="searchTerm"
                           value="@searchTerm"
                           class="form-control shadow-none"
                           placeholder="Nhập mã căn hộ (VD: A101, B202)..." />
                </div>

                <div class="col-6 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 shadow-sm">
                        🔍 Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Danh Sách Căn Hộ</h5>
            <span class="badge bg-light text-muted border">@Model.Count() căn hộ</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="ps-4 py-3">Mã Căn Hộ</th>
                                <th class="py-3">Tòa Nhà</th>
                                <th class="py-3">Tầng</th>
                                <th class="py-3">Diện Tích</th>
                                <th class="py-3">Trạng Thái</th>
                                <th class="py-3 text-end pe-4">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-5">🚪</span>
                                            <span>@item.ApartmentCode</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.Building?.BuildingCode ?? "N/A")
                                        </span>
                                        <span class="small text-muted ms-1">
                                            @(item.Building?.BuildingName ?? "")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">Tầng @item.Floor</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@item.Area.ToString("N1") m²</span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Đang sử dụng")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                ● @item.Status
                                            </span>
                                        }
                                        else if (item.Status == "Đang trống")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                ○ @item.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                🛠️ @item.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.ApartmentId" class="btn btn-outline-info" title="Xem chi tiết">
                                                Chi tiết
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ApartmentId" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ApartmentId" class="btn btn-outline-danger" title="Xóa căn hộ">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <span class="fs-1 d-block mb-2">🔍</span>
                    <h6 class="fw-bold text-secondary">Không tìm thấy căn hộ nào</h6>
                    <p class="text-muted small mb-3">Thử thay đổi bộ lọc hoặc thêm căn hộ mới vào hệ thống.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary">
                        ➕ Thêm Căn Hộ
                    </a>
                </div>
            }
        </div>
    </div>
</div>