@model ApartmentManagement.Models.Apartment

@{
    ViewData["Title"] = "Chỉnh Sửa Căn Hộ: " + Model.ApartmentCode;
    var buildings = ViewBag.Buildings as IEnumerable<ApartmentManagement.Models.Building> ?? Enumerable.Empty<ApartmentManagement.Models.Building>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-3">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Căn Hộ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa: @Model.ApartmentCode</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-warning text-dark py-3 px-4 bg-gradient">
                    <h4 class="fw-bold mb-1">✏️ Chỉnh Sửa Căn Hộ: @Model.ApartmentCode</h4>
                    <p class="mb-0 text-muted small">Cập nhật thông tin chi tiết căn hộ</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.ApartmentId" method="post">
                        <input type="hidden" asp-for="ApartmentId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BuildingId" class="form-label fw-semibold text-secondary small">
                                    Tòa Nhà <span class="text-danger">*</span>
                                </label>
                                <select asp-for="BuildingId" class="form-select">
                                    <option value="">-- Chọn tòa nhà --</option>
                                    @foreach (var building in buildings)
                                    {
                                        <option value="@building.BuildingId" selected="@(Model.BuildingId == building.BuildingId)">
                                            @building.BuildingCode - @building.BuildingName (@building.NumberOfFloors tầng)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="BuildingId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ApartmentCode" class="form-label fw-semibold text-secondary small">
                                    Mã Căn Hộ <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ApartmentCode" class="form-control" placeholder="VD: A101" style="text-transform: uppercase;" />
                                <span asp-validation-for="ApartmentCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Floor" class="form-label fw-semibold text-secondary small">
                                    Số Tầng <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Floor" class="form-control" type="number" min="1" max="200" />
                                <span asp-validation-for="Floor" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Area" class="form-label fw-semibold text-secondary small">
                                    Diện Tích (m²) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Area" class="form-control" type="number" step="0.01" min="1" />
                                <span asp-validation-for="Area" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary small">
                                    Trạng Thái Căn Hộ <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Đang sử dụng">Đang sử dụng</option>
                                    <option value="Đang trống">Đang trống</option>
                                    <option value="Đang bảo trì">Đang bảo trì</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold shadow-sm">
                                💾 Cập Nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}