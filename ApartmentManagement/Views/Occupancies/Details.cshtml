@model ApartmentManagement.Models.ApartmentResident
@{ ViewData["Title"] = "Chi tiết cư trú"; }
<div class="container py-4">@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="card-header @(Model.MoveOutDate == null ? "bg-success" : "bg-secondary") text-white p-4"><h4>@Model.Resident.User.FullName</h4><div>@Model.Apartment.ApartmentCode — @Model.Apartment.Building?.BuildingName</div></div><div class="card-body p-4"><dl class="row"><dt class="col-4">Quan hệ</dt><dd class="col-8">@Model.Relationship</dd><dt class="col-4">Vai trò</dt><dd class="col-8">@(Model.IsOwner ? "Chủ hộ" : "Thành viên")</dd><dt class="col-4">Ngày chuyển vào</dt><dd class="col-8">@Model.MoveInDate.ToString("dd/MM/yyyy")</dd><dt class="col-4">Ngày chuyển đi</dt><dd class="col-8">@(Model.MoveOutDate?.ToString("dd/MM/yyyy") ?? "Đang cư trú")</dd></dl><a asp-action="Index" class="btn btn-outline-secondary">Danh sách</a> @if (Model.MoveOutDate == null) { <a asp-action="MoveOut" asp-route-id="@Model.ApartmentResidentId" class="btn btn-danger">Làm thủ tục chuyển đi</a> }</div></div></div>
