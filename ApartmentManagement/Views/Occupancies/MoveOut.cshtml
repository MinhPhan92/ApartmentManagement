@model ApartmentManagement.Models.MoveOutViewModel
@{ ViewData["Title"] = "Thủ tục chuyển đi"; var occupancy = (ApartmentManagement.Models.ApartmentResident)ViewBag.Occupancy; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="card-header bg-danger text-white p-4"><h4>🚪 Thủ Tục Chuyển Đi</h4></div><div class="card-body p-4"><div class="alert alert-warning"><strong>@occupancy.Resident.User.FullName</strong><br />@occupancy.Apartment.ApartmentCode — @occupancy.Apartment.Building?.BuildingName<br />Chuyển vào: @occupancy.MoveInDate.ToString("dd/MM/yyyy")</div><form method="post"><input asp-for="ApartmentResidentId" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><label asp-for="MoveOutDate" class="form-label"></label><input asp-for="MoveOutDate" class="form-control mb-3" /><span asp-validation-for="MoveOutDate" class="text-danger"></span><div class="text-end"><a asp-action="Details" asp-route-id="@Model.ApartmentResidentId" class="btn btn-outline-secondary">Hủy</a> <button class="btn btn-danger">Xác nhận chuyển đi</button></div></form></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
