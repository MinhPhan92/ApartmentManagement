@model ApartmentManagement.Models.MoveInViewModel
@{ ViewData["Title"] = "Thủ tục chuyển vào"; var apartments = (IEnumerable<ApartmentManagement.Models.Apartment>)ViewBag.Apartments; var residents = (IEnumerable<ApartmentManagement.Models.Resident>)ViewBag.Residents; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-8"><div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="card-header bg-primary text-white p-4"><h4>🏠 Thủ Tục Chuyển Vào</h4></div><div class="card-body p-4"><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="ApartmentId" class="form-label"></label><select asp-for="ApartmentId" class="form-select"><option value="0">-- Chọn căn hộ --</option>@foreach (var x in apartments) { <option value="@x.ApartmentId">@x.ApartmentCode — @x.Building?.BuildingName</option> }</select><span asp-validation-for="ApartmentId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ResidentId" class="form-label"></label><select asp-for="ResidentId" class="form-select"><option value="0">-- Chọn cư dân --</option>@foreach (var x in residents) { <option value="@x.ResidentId">@x.User.FullName — @x.CitizenId</option> }</select><span asp-validation-for="ResidentId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Relationship" class="form-label"></label><input asp-for="Relationship" class="form-control" placeholder="Chủ hộ, thành viên, khách thuê..." /><span asp-validation-for="Relationship" class="text-danger"></span></div><div class="col-md-6"><label asp-for="MoveInDate" class="form-label"></label><input asp-for="MoveInDate" class="form-control" /><span asp-validation-for="MoveInDate" class="text-danger"></span></div><div class="col-12"><div class="form-check"><input asp-for="IsOwner" class="form-check-input" /><label asp-for="IsOwner" class="form-check-label"></label></div></div></div><hr /><div class="text-end"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a> <button class="btn btn-primary">Xác nhận chuyển vào</button></div></form></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
