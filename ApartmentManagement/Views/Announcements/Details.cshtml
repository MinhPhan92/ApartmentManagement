@model ApartmentManagement.Models.Announcement

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            @if (Model.IsPinned)
                            {
                                <span class="badge bg-warning text-dark me-1"><i class="bi bi-pin-angle-fill"></i> Đã ghim</span>
                            }
                            <span class="badge bg-secondary me-1">@Model.Category</span>
                            @if (Model.Building != null)
                            {
                                <span class="badge bg-info text-dark">Tòa: @Model.Building.BuildingCode</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Toàn khu chung cư</span>
                            }
                        </div>
                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <h3 class="fw-bold mb-3 text-dark">@Model.Title</h3>
                    <hr />

                    <div class="content py-3 fs-6" style="white-space: pre-wrap; line-height: 1.7;">
                        @Model.Content
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center text-muted small pt-2">
                        <span>Đăng bởi: <strong>@(Model.CreatedByUser?.FullName ?? "Ban Quản Lý")</strong></span>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left"></i> Quay lại Bảng tin
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
